<Window x:Class="Aurora.App.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏崩溃报告" Width="820" MaxHeight="820"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FFE6EAF2"/>
        <SolidColorBrush x:Key="InkDim" Color="#FF99A2B5"/>
        <SolidColorBrush x:Key="InkFaint" Color="#FF6D7588"/>
        <LinearGradientBrush x:Key="TitleGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFB9C7E6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF5B8CFF" Offset="0"/>
            <GradientStop Color="#FF37D6E0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="#14FFFFFF"
                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5B8CFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="{StaticResource AccentGrad}"
                                    Opacity="0.45" Margin="-3">
                                <Border.Effect>
                                    <BlurEffect Radius="14"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="10" Background="{StaticResource AccentGrad}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#FF10141C" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Margin="22,18,14,0" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#33FF6B6B">
                        <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="#FFFF8A8A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="游戏崩溃了" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="下面是启动器从日志和崩溃报告里看出来的东西"
                                   FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Style="{StaticResource SoftButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Padding="10,4" FontSize="11" Click="OnClose"/>
            </Grid>

            <!-- 结论 -->
            <Border Grid.Row="1" CornerRadius="14" Background="#14FFFFFF" BorderBrush="#26FFFFFF"
                    BorderThickness="1" Margin="22,14,22,0" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border CornerRadius="6" Background="#3322D3EE" Padding="8,3">
                            <TextBlock x:Name="CategoryText" Text="未知" FontSize="10.5" Foreground="#FF7FE3F0"/>
                        </Border>
                        <Border CornerRadius="6" Background="#1AFFFFFF" Padding="8,3" Margin="8,0,0,0">
                            <TextBlock x:Name="ConfidenceText" Text="推测" FontSize="10.5"
                                       Foreground="{StaticResource InkDim}"/>
                        </Border>
                        <TextBlock x:Name="ExitCodeText" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="HeadlineText" Text="游戏异常退出" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleGrad}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VerdictText" FontSize="11.5" Foreground="{StaticResource InkDim}"
                               Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- 原因 / 建议 / 原文 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                <StackPanel>
                    <TextBlock Text="可能的原因" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" Margin="2,0,0,8"/>
                    <ItemsControl x:Name="CauseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,6" Padding="12,9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,4,0,0"
                                                   Foreground="{StaticResource InkDim}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="可以试试" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" Margin="2,12,0,8"/>
                    <ItemsControl x:Name="SuggestionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                    <TextBlock Text="›" FontSize="12" Foreground="#FF7FA6FF" Margin="0,-1,8,0"/>
                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource InkDim}"
                                               TextWrapping="Wrap" MaxWidth="690"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="ReportToggle" Content="▸ 原始报告 / 日志（发给作者用）"
                            Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                            FontSize="11.5" Padding="12,6" Click="OnToggleReport"/>
                    <Border x:Name="ReportHost" Visibility="Collapsed" Margin="0,8,0,6">
                        <TextBox x:Name="ReportBox" IsReadOnly="True" AcceptsReturn="True" Height="230"
                                 Background="#FF0B0E13" Foreground="#FF9FB0C8"
                                 BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="10,8"
                                 FontFamily="Consolas" FontSize="10.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Grid Grid.Row="3" Margin="22,16,22,20">
                <StackPanel Orientation="Horizontal">
                    <Button Content="复制结论" Style="{StaticResource SoftButton}" Click="OnCopy"/>
                    <Button Content="导出报告" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="OnExport"/>
                    <Button x:Name="OpenFolderButton" Content="打开崩溃报告文件夹"
                            Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="OnOpenFolder"/>
                </StackPanel>
                <Button Content="我知道了" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                        Click="OnClose"/>
            </Grid>
        </Grid>
    </Border>
</Window>
