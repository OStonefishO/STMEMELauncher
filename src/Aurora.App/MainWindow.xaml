                            <Border MaxWidth="760" CornerRadius="28" Background="#40080F20"
                                    BorderBrush="#66B6C8FF" BorderThickness="1" Padding="34,28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#9952C7FF" BlurRadius="60" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="CURRENT VERSION" FontSize="10.5" Foreground="{DynamicResource InkFaint}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="86" FontWeight="Black" FontFamily="{DynamicResource FontNum}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TitleGrad}"
                                               Text="{Binding Text, ElementName=BigVersion}"/>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Text="{Binding Text, ElementName=DetName}"/>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource InkDim}" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" Text="{Binding Text, ElementName=DetMeta}"/>
                                    <Button Content="▶  开始游戏" Style="{StaticResource HeroButton}" Height="52" Width="260"
                                            HorizontalAlignment="Center" Margin="0,20,0,0" Click="OnLaunch" Tag="noBounce"/>
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <Button Content="打开目录" Style="{StaticResource GlassButton}" Click="OnOpenFolder"/>
                                        <Button Content="内容库" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="2" Click="OnNavClick"/>
                                        <Button Content="版本" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="7" Click="OnNavClick"/>
                                        <Button x:Name="AuroraKillButton" Content="强制关闭" Style="{StaticResource DangerButton}"
                                                Margin="8,0,0,0" Click="OnForceKillGame" Visibility="Collapsed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>


                        <Grid x:Name="PixelHome" Grid.Row="1" Margin="26,0,26,60" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.25*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="2" CornerRadius="2" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="2" Padding="22" Margin="0,0,8,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT VERSION" FontSize="10" FontFamily="{DynamicResource FontNum}"
                                               Foreground="{DynamicResource InkFaint}"/>
                                    <TextBlock FontSize="72" FontFamily="{DynamicResource FontNum}" FontWeight="Bold"
                                               Foreground="{DynamicResource TitleGrad}" Margin="0,8,0,0"
                                               Text="{Binding Text, ElementName=BigVersion}"/>
                                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                               Margin="0,6,0,0" Text="{Binding Text, ElementName=DetName}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource InkDim}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Text="{Binding Text, ElementName=DetMeta}"/>
                                    <Button Content="▶ START" Style="{StaticResource HeroButton}" Height="52" Margin="0,20,0,0"
                                            FontFamily="{DynamicResource FontNum}" FontSize="15" Click="OnLaunch" Tag="noBounce"/>
                                    <Button x:Name="PixelKillButton" Content="强制关闭" Style="{StaticResource DangerButton}"
                                            Margin="0,8,0,0" Click="OnForceKillGame" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Grid.Row="0" CornerRadius="2" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="2" Padding="18" Margin="8,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CONTENT" FontSize="10" FontFamily="{DynamicResource FontNum}"
                                               Foreground="{DynamicResource InkFaint}"/>
                                    <TextBlock Text="内容库" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,6,0,0"/>
                                    <Button Content="进入 →" Style="{StaticResource GlassButton}" Margin="0,14,0,0"
                                            HorizontalAlignment="Left" Tag="2" Click="OnNavClick"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Grid.Row="1" CornerRadius="2" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="2" Padding="18" Margin="8,8,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MENU" FontSize="10" FontFamily="{DynamicResource FontNum}"
                                               Foreground="{DynamicResource InkFaint}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="版本" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="7" Click="OnNavClick"/>
                                        <Button Content="联机" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="6" Click="OnNavClick"/>
                                        <Button Content="账号" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="3" Click="OnNavClick"/>
                                        <Button Content="设置" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="4" Click="OnNavClick"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>


                        <Grid x:Name="DashboardGrid" Grid.Row="1" Margin="26,0,26,64" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.05*"/>
                                <RowDefinition Height="0.95*"/>
                                <RowDefinition Height="0.9*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="3" CornerRadius="22" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="28,24"
                                    Margin="0,0,14,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT VERSION" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkFaint}"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock FontSize="96" FontWeight="Black" FontFamily="{DynamicResource FontNum}"
                                                   Foreground="{DynamicResource AccentGrad}" Opacity="0.5"
                                                   Text="{Binding Text, ElementName=BigVersion}" IsHitTestVisible="False">
                                            <TextBlock.Effect><BlurEffect Radius="26"/></TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock FontSize="96" FontWeight="Black" FontFamily="{DynamicResource FontNum}"
                                                   Foreground="{DynamicResource TitleGrad}"
                                                   Text="{Binding Text, ElementName=BigVersion}"/>
                                    </Grid>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Text, ElementName=DetName}"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource InkDim}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Text="{Binding Text, ElementName=DetMeta}"/>
                                    <Button Content="▶  开始游戏" Style="{StaticResource HeroButton}" Height="56"
                                            FontSize="17" Margin="0,20,0,0" Click="OnLaunch" Tag="noBounce"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="打开目录" Style="{StaticResource GlassButton}" Click="OnOpenFolder"/>
                                        <Button Content="内容库" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="2" Click="OnNavClick"/>
                                        <Button Content="版本管理" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="7" Click="OnNavClick"/>
                                        <Button x:Name="DashKillButton" Content="强制关闭游戏" Style="{StaticResource DangerButton}"
                                                Margin="8,0,0,0" Click="OnForceKillGame" Visibility="Collapsed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3D 方块岛（新版首页保留的招牌画面） -->
                            <Border Grid.Column="1" Grid.Row="0" CornerRadius="20" Background="{DynamicResource FieldBg}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" ClipToBounds="True"
                                    Margin="0,0,0,8">
                                <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnDashboardBiomeClick">
                                    <Viewport3D x:Name="DashViewport"/>
                                    <TextBlock x:Name="DashBiomeText" Text="主世界" FontSize="10.5"
                                               Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Margin="0,0,12,10" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Grid.Row="1" CornerRadius="20" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="内容 / 模组" FontSize="11.5" Foreground="{DynamicResource InkFaint}"/>
                                    <TextBlock Text="装模组、材质包、整合包" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}" Margin="0,6,0,2"/>
                                    <TextBlock Text="一个入口，四个来源" FontSize="11.5" Foreground="{DynamicResource InkDim}"/>
                                    <Button Content="进入内容页 →" Style="{StaticResource GlassButton}" Margin="0,12,0,0"
                                            HorizontalAlignment="Left" Tag="2" Click="OnNavClick"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Grid.Row="2" CornerRadius="20" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="快捷入口" FontSize="11.5" Foreground="{DynamicResource InkFaint}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="账户" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="3" Click="OnNavClick"/>
                                        <Button Content="联机" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="6" Click="OnNavClick"/>
                                        <Button Content="其他" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="10" Click="OnNavClick"/>
                                        <Button Content="设置" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="4" Click="OnNavClick"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="HeroGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：版本信息 + 启动 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="26,0,0,10">
                                <TextBlock Text="CURRENT VERSION" FontSize="10.5" Foreground="{DynamicResource InkFaint}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock x:Name="BigVersionGlow" FontSize="96" FontFamily="{DynamicResource FontNum}"
                                               FontWeight="Black" Foreground="{DynamicResource AccentGrad}" Opacity="0.55"
                                               Text="{Binding Text, ElementName=BigVersion}" IsHitTestVisible="False">
                                        <TextBlock.Effect><BlurEffect Radius="26"/></TextBlock.Effect>
                                    </TextBlock>
                                <TextBlock x:Name="BigVersion" Text="—" FontSize="96" FontFamily="{DynamicResource FontNum}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TitleGrad}"/>
                                </Grid>
                                <TextBlock x:Name="DetName" Text="选择一个版本" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetMeta" Text="—" FontSize="12" Foreground="{DynamicResource InkDim}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,20,0,0">
                                    <Border CornerRadius="9" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource GlassLine}"
                                            BorderThickness="1" Padding="12,7" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="JAVA" FontSize="9.5" Foreground="{DynamicResource InkFaint}"/>
                                            <TextBlock x:Name="DetJava" Text="—" FontSize="11.5" Foreground="{DynamicResource Ink}"
                                                       Margin="0,2,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="9" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource GlassLine}"
                                            BorderThickness="1" Padding="12,7" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="MODS" FontSize="9.5" Foreground="{DynamicResource InkFaint}"/>
                                            <TextBlock x:Name="DetMods" Text="—" FontSize="11.5" Foreground="{DynamicResource Ink}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="9" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource GlassLine}"
                                            BorderThickness="1" Padding="12,7" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="内存" FontSize="9.5" Foreground="{DynamicResource InkFaint}"/>
                                            <TextBlock x:Name="DetMemory" Text="—" FontSize="11.5" Foreground="{DynamicResource Ink}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="JavaModeButton" Content="Java：自动" Style="{StaticResource GlassButton}"
                                            Padding="12,5" FontSize="10.5" Click="OnHomeToggleJavaMode"
                                            ToolTip="自动：按版本需要的 Java 挑；手动：用你指定的那个"/>
                                    <Button Content="扫描 Java" Style="{StaticResource GlassButton}" Padding="12,5"
                                            FontSize="10.5" Margin="8,0,0,0" Click="OnHomeScanJava"/>
                                    <Button Content="选择 java.exe" Style="{StaticResource GlassButton}" Padding="12,5"
                                            FontSize="10.5" Margin="8,0,0,0" Click="OnHomePickJava"/>
                                    <TextBlock x:Name="HomeJavaHint" Text="" FontSize="10.5"
                                               Foreground="{DynamicResource InkFaint}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                </WrapPanel>

                                <Button x:Name="LaunchButton" Style="{StaticResource HeroButton}" Width="300" Height="60"
                                        HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnLaunch" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                        <TextBlock Text="开始游戏" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ForceKillButton" Content="强制关闭游戏" Style="{StaticResource DangerButton}"
                                        Height="32" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Visibility="Collapsed" Click="OnForceKillGame"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="打开目录" Style="{StaticResource GlassButton}" Click="OnOpenFolder"
                                            FontSize="11.5" Padding="12,6"/>
                                    <TextBlock x:Name="DetDir" Text="" FontSize="10.5" Foreground="{DynamicResource InkFaint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="330"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 右：3D -->
                            <Grid Grid.Column="1" Margin="0,-10,-10,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="OnHeroClicked" ToolTip="点一下换群系：主世界 / 下界 / 末地">
                                <Viewport3D x:Name="HeroViewport" Opacity="0.98">
                                    <Viewport3D.Effect>
                                        <DropShadowEffect Color="#5B8CFF" BlurRadius="60" ShadowDepth="0" Opacity="0.35"/>
                                    </Viewport3D.Effect>
                                </Viewport3D>
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                                            IsHitTestVisible="False">
                                    <TextBlock x:Name="HeroBiomeText" Text="主世界 · 点一下换群系" FontSize="10.5"
                                               Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroBiomeHint" Text="草地、木头、还有两颗小树" FontSize="9.5"
                                               Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Java（六套界面共用这一行） -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="26,0,0,10">
                            <Button x:Name="GlobalJavaButton" Content="Java：自动" Style="{StaticResource GlassButton}"
                                    Padding="14,6" FontSize="11.5" Click="OnOpenGlobalJava"
                                    ToolTip="点一下选 Java：自动匹配 / 指定某个 java.exe"/>
                            <TextBlock x:Name="GlobalJavaHint" Text="" FontSize="10.5"
                                       Foreground="{DynamicResource InkFaint}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- 版本轮播 -->
                        <StackPanel Grid.Row="2" Margin="26,0,0,6">
                            <Grid Margin="0,0,0,4">
                                <Button x:Name="VersionPickerButton" HorizontalAlignment="Left" Height="46" MinWidth="330"
                                        Style="{StaticResource GlassButton}" Padding="20,0" Click="OnPickVersion">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="当前版本" FontSize="11.5" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="VersionPickerText" Text="未选择" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                                                   MaxWidth="380" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="▾" FontSize="12" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="VersionPopover" PlacementTarget="{Binding ElementName=VersionPickerButton}"
                                       Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                       Opened="OnVersionPopoverOpened">
                                    <!-- 配色跟着主题走：六套主题各自设 PopBg / PopLine / PopHover / PopActive 等 -->
                                    <Border x:Name="VersionPopoverCard" CornerRadius="14"
                                            Background="{DynamicResource PopBg}" BorderBrush="{DynamicResource PopLine}"
                                            BorderThickness="1" Padding="10" Margin="0,0,0,10" Width="442">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel x:Name="VersionPopoverRoot"/>
                                    </Border>
                                </Popup>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="版本管理" Style="{StaticResource GlassButton}" Padding="12,4" FontSize="11"
                                            Click="OnOpenVersionManager"/>
                                    <Button Content="导入整合包" Style="{StaticResource GlassButton}" Padding="12,4" FontSize="11"
                                            Margin="8,0,0,0" Click="OnImportPackHome"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0" Height="0" Visibility="Collapsed"
                                     PreviewMouseWheel="OnVersionWheel"
                                     ItemContainerStyle="{StaticResource VersionTile}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnVersionSelected">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="3" Height="14" CornerRadius="2" Background="{Binding LoaderColor}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ShortName}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                                                           Width="168"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="11,5,0,0"
                                                       Foreground="{DynamicResource InkDim}" TextTrimming="CharacterEllipsis"
                                                       Width="198"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>

                    <!-- ========== 安装页 ========== -->
                    <Grid x:Name="InstallPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="内容" FontSize="32" FontFamily="{DynamicResource FontHead}" Foreground="{DynamicResource TitleGrad}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="安装版本" Style="{StaticResource HeroButton}" Height="34" Width="110" Padding="0" Click="OnTabInstall"/>
                                <Button Content="内容下载" Style="{StaticResource GlassButton}" Height="34" Width="110" Padding="0"
                                        Margin="10,0,0,0" Click="OnTabContent"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="16" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="12,10,10,8">
                                        <TextBlock Text="Minecraft 正式版" FontSize="11.5" Foreground="{DynamicResource InkFaint}"/>
                                        <Grid Margin="0,8,0,0">
                                            <TextBox x:Name="VersionSearchBox" Height="30" Padding="9,6,9,6"
                                                     TextChanged="OnVersionSearch"/>
                                            <TextBlock x:Name="VersionSearchHint" Text="搜索版本号，如 1.21 / 26.2"
                                                       IsHitTestVisible="False" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11.5"
                                                       Foreground="{DynamicResource InkFaint}"/>
                                        </Grid>
                                        <CheckBox x:Name="SnapshotToggle" Content="含预览版（快照 / 愚人节）" FontSize="11.5"
                                                  Foreground="{DynamicResource InkDim}" Margin="2,8,0,0"
                                                  Checked="OnSnapshotToggle" Unchecked="OnSnapshotToggle"/>
                                    </StackPanel>
                                    <ListBox x:Name="McVersionList" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Ink}" SelectionChanged="OnMcVersionSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,5">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding ReleaseTime}" FontSize="10.5"
                                                               Foreground="{DynamicResource InkFaint}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="22,18">
                                    <StackPanel>
                                        <TextBlock x:Name="InstallMcText" Text="先在左边选一个 Minecraft 版本"
                                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="加载器会安装到上面这个版本之上；原版会自动补齐。"
                                                   FontSize="11.5" Foreground="{DynamicResource InkDim}"
                                                   Margin="0,7,0,18" TextWrapping="Wrap"/>

                                        <TextBlock Text="加载器" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                        <ComboBox x:Name="LoaderCombo" Margin="0,6,0,14" SelectedIndex="0"
                                                  SelectionChanged="OnLoaderChanged">
                                            <ComboBoxItem Content="原版（不装加载器）"/>
                                            <ComboBoxItem Content="Fabric"/>
                                            <ComboBoxItem Content="NeoForge"/>
                                            <ComboBoxItem Content="Forge"/>
                                        </ComboBox>

                                        <TextBlock Text="加载器版本" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                        <ComboBox x:Name="LoaderVersionCombo" Margin="0,6,0,0" IsEnabled="False"/>
                                        <TextBlock x:Name="LoaderHint" Text="选了加载器后会自动拉取可用版本" FontSize="10.5"
                                                   Foreground="{DynamicResource InkFaint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="InstallButton" Content="开始安装" Style="{StaticResource HeroButton}"
                                            Height="52" Width="210" Click="OnInstall" IsEnabled="False"/>
                                    <Button x:Name="CancelInstallButton" Content="取消安装"
                                            Style="{StaticResource GlassButton}" Height="52" Margin="10,0,0,0"
                                            Click="OnCancelInstall" Visibility="Collapsed"
                                            ToolTip="可以同时装好几个版本，这个只取消正在进行的安装"/>
                                </StackPanel>

                                <ProgressBar x:Name="InstallBar" Height="5" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                             Foreground="{DynamicResource AccentGrad}" Background="{DynamicResource FieldBg}" BorderThickness="0"/>
                                <TextBlock x:Name="InstallText" Text="等待选择" FontSize="11.5" Margin="0,8,0,0"
                                           Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ========== 内容页 ========== -->
                    <Grid x:Name="ContentPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="内容" FontSize="32" FontFamily="{DynamicResource FontHead}" Foreground="{DynamicResource TitleGrad}"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="安装版本" Style="{StaticResource GlassButton}" Height="34" Width="110"
                                            Padding="0" Click="OnTabInstall"/>
                                    <Button Content="内容下载" Style="{StaticResource HeroButton}" Height="34" Width="110"
                                            Padding="0" Margin="10,0,0,0" Click="OnTabContent"/>
                                </StackPanel>
                                <Button x:Name="DownloadsButton" Content="下载管理" HorizontalAlignment="Right"
                                        Style="{StaticResource GlassButton}" Height="34" Click="OnToggleDownloads"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <WrapPanel Orientation="Horizontal">
                                    <ComboBox x:Name="KindCombo" Width="110" SelectedIndex="0" SelectionChanged="OnKindChanged">
                                        <ComboBoxItem Content="模组"/>
                                        <ComboBoxItem Content="整合包"/>
                                        <ComboBoxItem Content="光影"/>
                                        <ComboBoxItem Content="资源包"/>
                                    
                                    <ComboBoxItem Content="地图"/>
                                </ComboBox>
                                    <ComboBox x:Name="SourceCombo" Width="132" Margin="8,0,0,0" SelectedIndex="0"
                                              SelectionChanged="OnSourceChanged">
                                        <ComboBoxItem Content="Modrinth"/>
                                        <ComboBoxItem Content="CurseForge"/>
                                    </ComboBox>
                                    <Grid x:Name="ContentVersionHost" Width="190" Height="36" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="ContentLoaderCombo" Width="112" Margin="8,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="任意加载器"/>
                                        <ComboBoxItem Content="fabric"/>
                                        <ComboBoxItem Content="forge"/>
                                        <ComboBoxItem Content="neoforge"/>
                                        <ComboBoxItem Content="quilt"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CategoryCombo" Width="150" Margin="8,0,0,0"/>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Grid Width="300" Margin="0,0,0,6">
                                        <TextBox x:Name="QueryBox" VerticalContentAlignment="Center" Padding="9,6,9,6"
                                                 TextChanged="OnQueryTextChanged"/>
                                        <TextBlock x:Name="QueryHint" Text="搜索模组 / 整合包 / 光影 / 资源包"
                                                   IsHitTestVisible="False" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11.5"
                                                   Foreground="{DynamicResource InkFaint}"/>
                                    </Grid>
                                    <Button Content="搜索" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="OnSearch"/>

                                    <TextBlock x:Name="PageText" Text="" FontSize="11.5" Margin="18,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource InkFaint}"/>
                                    <Button x:Name="PrevButton" Content="‹ 上一页" Style="{StaticResource GlassButton}"
                                            Margin="10,0,0,0" Padding="12,6" FontSize="11.5" Click="OnPrevPage" IsEnabled="False"/>
                                    <Button x:Name="NextButton" Content="下一页 ›" Style="{StaticResource GlassButton}"
                                            Margin="6,0,0,0" Padding="12,6" FontSize="11.5" Click="OnNextPage" IsEnabled="False"/>
                                </WrapPanel>

                                <!-- 站外搜索：这些站没有开放 API，直接带关键词跳过去 -->
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="站外搜：" FontSize="10.5" Foreground="{DynamicResource InkFaint}"
                                               VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Button Content="MC 百科" Style="{StaticResource GlassButton}" Padding="10,4"
                                            FontSize="10.5" Margin="0,0,6,4" Click="OnSearchSite"
                                            Tag="https://search.mcmod.cn/s?key={q}" ToolTip="中文模组百科，搜中文介绍最准"/>
                                    <Button Content="Planet Minecraft" Style="{StaticResource GlassButton}" Padding="10,4"
                                            FontSize="10.5" Margin="0,0,6,4" Click="OnSearchSite"
                                            Tag="https://www.planetminecraft.com/mods/?keywords={q}"/>
                                    <Button Content="Minecraft Maps" Style="{StaticResource GlassButton}" Padding="10,4"
                                            FontSize="10.5" Margin="0,0,6,4" Click="OnSearchSite"
                                            Tag="https://www.minecraftmaps.com/?s={q}" ToolTip="主要是地图，搜不到就当逛站"/>
                                    <Button Content="Nexus Mods" Style="{StaticResource GlassButton}" Padding="10,4"
                                            FontSize="10.5" Margin="0,0,6,4" Click="OnSearchSite"
                                            Tag="https://www.nexusmods.com/games/minecraft/search?keyword={q}"/>
                                    <Button Content="ShadersMods" Style="{StaticResource GlassButton}" Padding="10,4"
                                            FontSize="10.5" Margin="0,0,6,4" Click="OnSearchSite"
                                            Tag="https://shadersmods.com/?s={q}" ToolTip="光影整合站"/>
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="6">
                                <ListBox x:Name="ContentList" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Ink}" SelectionChanged="OnContentSelected"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseLeftButtonUp="OnContentListClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <EventSetter Event="MouseLeftButtonUp" Handler="OnContentItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource FieldBg}"
                                                        VerticalAlignment="Top">
                                                    <Grid>
                                                        <TextBlock Text="▦" FontSize="15" Foreground="{DynamicResource InkFaint}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Icon}" Width="44" Height="44"
                                                               Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource Ink}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,4,0,0"
                                                               LineHeight="17" Foreground="{DynamicResource InkDim}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Meta}" FontSize="10.5" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource InkFaint}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- 底部状态提示（安装条已移除：进详情页就能选版本安装） -->
                        <TextBlock Grid.Row="2" x:Name="ContentStatus" Text="搜索后点一个条目进详情，选版本安装"
                                   FontSize="11.5" Margin="26,8,0,10"
                                   Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"/>
                        <!-- 下载管理抽屉 -->
                        <Border x:Name="DownloadPanel" Visibility="Collapsed" Width="420" HorizontalAlignment="Right"
                                Margin="0,10,16,16" CornerRadius="16" Background="{DynamicResource PopBg}"
                                BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="下载管理" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="打开目录" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11"
                                                Click="OnOpenDownloadFolder"/>
                                        <Button Content="清空已结束" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11"
                                                Margin="6,0,0,0" Click="OnClearDownloads"/>
                                        <Button Content="✕" Style="{StaticResource GlassButton}" Padding="8,4" FontSize="11"
                                                Margin="6,0,0,0" Click="OnToggleDownloads"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DownloadList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Background="{DynamicResource FieldBg}" Padding="12,10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                                   Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                                   Foreground="{DynamicResource InkFaint}" Margin="0,3,0,6"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                                     Background="{DynamicResource FieldBg}" Foreground="{DynamicResource AccentGrad}"
                                                                     BorderThickness="0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="暂停" Style="{StaticResource GlassButton}"
                                                                    Padding="10,3" FontSize="10.5" Click="OnPauseDownload"/>
                                                            <Button Content="继续" Style="{StaticResource GlassButton}"
                                                                    Padding="10,3" FontSize="10.5" Margin="6,0,0,0" Click="OnResumeDownload"/>
                                                            <Button Content="取消" Style="{StaticResource GlassButton}"
                                                                    Padding="10,3" FontSize="10.5" Margin="6,0,0,0" Click="OnCancelDownload"/>
                                                            <Button Content="删除" Style="{StaticResource DangerButton}"
                                                                    Height="24" Padding="10,0" FontSize="10.5" Margin="10,0,0,0"
                                                                    Click="OnRemoveDownload"
                                                                    ToolTip="把这条任务从列表里删掉（正在下的会先停掉）"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="2" x:Name="DownloadEmptyHint" Text="还没有下载任务"
                                           FontSize="11" Foreground="{DynamicResource InkFaint}" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 内容详情浮层 -->
                        <Grid x:Name="ContentDetailPanel" Grid.RowSpan="3" Visibility="Collapsed"
                              Background="{DynamicResource PopBg}">
                            <Grid.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
                            </Grid.Effect>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="26,16,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="‹ 返回" Style="{StaticResource GlassButton}" Click="OnCloseContentDetail"/>
                                    <Button x:Name="DetailMcmodButton" Content="MC 百科" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                            Click="OnOpenMcmodForDetail" ToolTip="在 MC 百科查这个模组（有对应页面就直接跳过去）"/>
                                    <Button x:Name="DetailTranslateButton" Content="翻译为中文" Style="{StaticResource GlassButton}"
                                            Margin="8,0,0,0" Click="OnDetailTranslate"
                                            ToolTip="翻译这个模组的简介（优先用 MC 百科的中文，没有就机翻）"/>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource FieldBg}" Margin="16,0,0,0">
                                        <Image x:Name="DetailIcon" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock x:Name="DetailTitle" Text="" FontSize="22" FontFamily="{DynamicResource FontHead}"
                                               Foreground="{DynamicResource Ink}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" Margin="26,0,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,24">
                                    <TextBlock x:Name="DetailSummary" Text="" FontSize="12.5"
                                               Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailStatus" Text="" FontSize="11.5" Margin="0,8,0,0"
                                               Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="DetailBody" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <!-- ========== 版本管理 ========== -->
                    <Grid x:Name="VersionsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="版本" FontSize="32" FontFamily="{DynamicResource FontHead}"
                                       Foreground="{DynamicResource TitleGrad}"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="VmDirCombo" Width="520" Height="32"
                                              SelectionChanged="OnVmDirChanged"/>
                                    <Button Content="添加文件夹" Style="{StaticResource GlassButton}" Height="32" Margin="10,0,0,0"
                                            Click="OnVmAddDir"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="16" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="已安装版本" FontSize="11.5"
                                               Foreground="{DynamicResource InkFaint}" Margin="12,10,10,8"/>
                                    <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
                                        <TextBox x:Name="VmSearchBox" Height="32"
                                                 FontSize="12" Background="{DynamicResource FieldBg}"
                                                 BorderBrush="{DynamicResource FieldLine}" BorderThickness="1"
                                                 Foreground="{DynamicResource Ink}" Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="OnVmSearchChanged" KeyDown="OnVmSearchKeyDown"
                                                 ToolTip="直接打字过滤，例如 1.12.2 / forge / fabric；回车选第一个"/>
                                        <TextBlock x:Name="VmSearchHint" Text="输入版本号过滤，如 1.12.2"
                                                   FontSize="12" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <ListBox x:Name="VmVersionList" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Ink}" SelectionChanged="OnVmVersionSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,5">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                               Foreground="{DynamicResource InkFaint}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,16,0">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="VmTabOverview" Content="概览" Tag="overview" Click="OnVmTab"
                                                Style="{StaticResource GlassButton}" Padding="16,6" FontSize="11.5" Margin="0,0,8,0"/>
                                        <Button x:Name="VmTabMods" Content="Mod 管理" Tag="mods" Click="OnVmTab"
                                                Style="{StaticResource GlassButton}" Padding="16,6" FontSize="11.5" Margin="0,0,8,0"/>
                                        <Button x:Name="VmTabExport" Content="导出整合包" Tag="export" Click="OnVmTab"
                                                Style="{StaticResource GlassButton}" Padding="16,6" FontSize="11.5"/>
                                        <Button x:Name="VmTabSettings" Content="设置" Tag="settings" Click="OnVmTab"
                                                Style="{StaticResource GlassButton}" Padding="16,6" FontSize="11.5" Margin="0,0,8,0"/>
                                        <Button x:Name="VmTabModify" Content="修改" Tag="modify" Click="OnVmTab"
                                                Style="{StaticResource GlassButton}" Padding="16,6" FontSize="11.5"/>
                                    </StackPanel>

                                    <Border x:Name="VmPaneOverview" CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock x:Name="VmTitle" Text="先在左边选一个版本" FontSize="18"
                                                       FontWeight="Bold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="VmPath" Text="" FontSize="11" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>

                                            <WrapPanel Margin="0,14,0,0">
                                                <Button Content="打开版本目录" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Click="OnVmOpenVersionDir"/>
                                                <Button Content="设为安装目标" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Click="OnVmSetAsTarget"/>
                                                <Button Content="补齐配置" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Click="OnVmFixConfig"
                                                        ToolTip="补上 mods / config / saves 等文件夹、options.txt 和 launcher_profiles.json"/>
                                                <Button Content="修复资源" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Click="OnVmRepair"
                                                        ToolTip="补下缺失的 assets / 依赖库 / natives（闪退报缺文件时用）"/>
                                        <Button x:Name="VmExportShortcut" Content="导出整合包" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                Click="OnVmGoExport" Tag="export" ToolTip="打开导出页签，按内容勾选打包"/>
                                        <Button x:Name="VmReinstallLoaderButton" Content="重装加载器" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                Click="OnVmReinstallLoader" IsEnabled="False"
                                                ToolTip="清掉 libraries 里的加载器核心后重装（NeoForge 报 corrupted 时用）"/>

                                            </WrapPanel>

                                            <TextBlock x:Name="IsolationHint" Text="" FontSize="10.5" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>

                                        <TextBlock Text="这个版本的 Mod" FontSize="11" Margin="0,14,0,0" Foreground="{DynamicResource InkFaint}"/>
                                        <TextBlock x:Name="VmModPreview" Text="" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"/>

                                            <TextBlock Text="快捷目录" FontSize="11" Margin="0,14,0,0" Foreground="{DynamicResource InkFaint}"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="mods" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="mods" Click="OnVmOpenFolder"/>
                                                <Button Content="saves（地图）" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="saves" Click="OnVmOpenFolder"/>
                                                <Button Content="导入存档" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Click="OnVmImportSave" ToolTip="把别处复制的存档（文件夹或 zip）放进这个版本实际读的 saves 目录"/>
                                                <Button Content="resourcepacks" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="resourcepacks" Click="OnVmOpenFolder"/>
                                                <Button Content="shaderpacks" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="shaderpacks" Click="OnVmOpenFolder"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="VmPaneSettings" CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="启动设置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="只对这个版本生效；内存这一项写的是全局值，改完点「应用」。" FontSize="10.5"
                                                       Foreground="{DynamicResource InkFaint}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                                            <TextBlock Text="运行内存 (MB)" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                                                <TextBox x:Name="VmMemoryBox" Width="140" HorizontalContentAlignment="Center"/>
                                                <Button Content="应用" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="OnVmSaveMemory"/>
                                            </StackPanel>

                                            <TextBlock Text="Java" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                                                <TextBlock x:Name="VmJavaText" Text="跟随全局" FontSize="11.5" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" Foreground="{DynamicResource Ink}"/>
                                                <Button Content="改 Java" Style="{StaticResource GlassButton}" Click="OnChangeVmJava"
                                                        ToolTip="只给这个版本指定 java.exe；「自动」= 按版本要求挑"/>
                                            </StackPanel>

                                            <TextBlock Text="版本隔离" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button x:Name="IsolationButton" Content="版本隔离：跟随全局"
                                                        Style="{StaticResource GlassButton}" Click="OnToggleIsolation"
                                                        ToolTip="开启后这个版本用自己目录里的 mods / config / saves，不跟全局共用"/>

                                                        <TextBlock Text="Fabric 生态" FontSize="11" Margin="0,14,0,0" Foreground="{DynamicResource InkFaint}"/>
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <Button Content="补装 Fabric API / Mod Menu" Style="{StaticResource GlassButton}"
                                                                    Click="OnInstallFabricEssentials"
                                                                    ToolTip="Fabric 本身不会改界面；补上这两个基础模组，模组菜单和大部分 mod 才能用"/>
                                                        </WrapPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="VmPaneModify" CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="修改这个版本" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="改名会同步改文件夹和 json；删除会问两次，删完进回收站。" FontSize="10.5"
                                                       Foreground="{DynamicResource InkFaint}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                                            <WrapPanel>
                                                <Button x:Name="VmRenameButton" Content="重命名"
                                                        Style="{StaticResource GlassButton}" Padding="14,6" FontSize="11" Margin="0,0,8,8"
                                                        IsEnabled="False" Click="OnVmRename" ToolTip="改版本名（文件夹、json、id 一起改）"/>
                                                <Button x:Name="VmDeleteButton" Content="删除版本"
                                                        Style="{StaticResource DangerButton}" Height="30" Padding="14,0"
                                                        FontSize="11" Margin="0,0,8,8" IsEnabled="False" Click="OnVmDeleteVersion"
                                                        ToolTip="删掉整个版本文件夹（会问两次，删完进回收站）"/>
                                            </WrapPanel>

                                            <TextBlock Text="备注" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource InkFaint}"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="VmNoteBox" Height="30" MaxLength="120"
                                                         ToolTip="这个版本的备注，导出整合包时会写进说明里"/>
                                                <Button Grid.Column="1" Content="保存备注" Style="{StaticResource GlassButton}" Height="30"
                                                        Margin="8,0,0,0" FontSize="11" Click="OnVmSaveNote"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="VmPaneMods" CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="模组" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="添加 mod" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                            Click="OnVmAddMods"/>
                                                    <Button Content="刷新" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                            Margin="8,0,0,0" Click="OnVmRefreshMods"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="可以直接把 .jar 拖进来；点开关启用/禁用（改扩展名，不删文件）"
                                                       FontSize="10.5" Foreground="{DynamicResource InkFaint}" Margin="0,6,0,10"/>
                                            <Grid Margin="0,0,0,10">
                                                <TextBox x:Name="VmModSearch" Height="30" Padding="9,6,9,6"
                                                         TextChanged="OnVmModSearch"/>
                                                <TextBlock x:Name="VmModSearchHint" Text="搜索模组文件名"
                                                           IsHitTestVisible="False" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{DynamicResource InkFaint}"/>
                                            </Grid>

                                            <Border CornerRadius="10" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" Padding="10"
                                                    AllowDrop="True" Drop="OnVmModsDrop" DragOver="OnVmModsDragOver">
                                                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="VmModList"/>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="VmPaneExport" CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="导出整合包" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="勾选要带上的内容，打包成 zip；别人用「导入整合包」就能装。" FontSize="10.5"
                                                       Foreground="{DynamicResource InkFaint}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="整合包名称" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                                    <TextBox x:Name="PackNameBox" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="整合包版本" FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                                    <TextBox x:Name="PackVersionBox" Text="1.0.0" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="导出内容" FontSize="11" Margin="0,16,0,6" Foreground="{DynamicResource InkFaint}"/>
                                            <WrapPanel>
                                                <CheckBox x:Name="PackPartOptions" Content="游戏设置 (options.txt)" IsChecked="True"
                                                          Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,16,8"/>
                                                <CheckBox x:Name="PackPartMods" Content="Mod" IsChecked="True"
                                                          Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,16,8"/>
                                                <CheckBox x:Name="PackPartConfig" Content="Mod 设置 (config)" IsChecked="True"
                                                          Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,16,8"/>
                                                <CheckBox x:Name="PackPartSaves" Content="单人存档 (saves)"
                                                          Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,16,8"/>
                                                <CheckBox x:Name="PackPartResourcePacks" Content="资源包"
                                                          Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,16,8"/>
                                                <CheckBox x:Name="PackPartShaderPacks" Content="光影"
                                                          Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,16,8"/>
                                            </WrapPanel>

                                            <Expander Header="高级选项" Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,8,0,0">
                                                <StackPanel Margin="0,10,0,0">
                                                    <CheckBox x:Name="PackIncludeAssets" Content="打包资源文件（assets，导入时不用再下，但体积很大）"
                                                              Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,0,8"/>
                                                    <CheckBox x:Name="PackModrinthOnly" Content="只记录 Modrinth 下载地址（不打包 mod 本体）"
                                                              Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,0,8"/>
                                                    <CheckBox x:Name="PackIncludeJar" Content="连原版 client.jar 一起打包（离线也能装）"
                                                              Foreground="{DynamicResource InkDim}" FontSize="11.5" Margin="0,0,0,8"/>
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <Button Content="读取配置" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                                Margin="0,0,8,0" Click="OnPackLoadConfig"/>
                                                        <Button Content="保存配置" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                                Margin="0,0,8,0" Click="OnPackSaveConfig"/>
                                                        <Button Content="制作指南" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                                Click="OnPackGuide"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Expander>

                                            <WrapPanel Margin="0,16,0,0">
                                                <Button Content="开始导出" Style="{StaticResource HeroButton}" Height="36" Width="150"
                                                        Click="OnVmExportPack"/>
                                                <Button Content="导入整合包" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                                        Click="OnVmImportPack"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="VmStatus" Text="" FontSize="11.5" Margin="4,12,0,20"
                                               Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ========== 联机页 ========== -->
                    <Grid x:Name="OnlinePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="联机" FontSize="32" FontFamily="{DynamicResource FontHead}"
                                       Foreground="{DynamicResource TitleGrad}"/>
                            <TextBlock Text="一键开服，然后把地址发给朋友；没有公网 IP 就用樱花穿透" FontSize="12.5"
                                       Foreground="{DynamicResource InkDim}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="一键开服" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                                <Button Content="开服教程" HorizontalAlignment="Right" Style="{StaticResource GlassButton}"
                                                        Padding="10,4" FontSize="11" Click="OnOpenServerGuide"/>
                                            </Grid>
                                            <TextBlock Text="用已安装的版本起服务端：原版 / Fabric / Forge / NeoForge 都行。"
                                                       FontSize="11" Foreground="{DynamicResource InkFaint}" Margin="0,5,0,12"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="版本" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                            <ComboBox x:Name="ServerVersionCombo" Margin="0,6,0,10" Height="34"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="端口" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                                    <TextBox x:Name="ServerPortBox" Text="25565" Margin="0,6,0,0" Height="32"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="内存 (MB)" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                                    <TextBox x:Name="ServerMemoryBox" Text="2048" Margin="0,6,0,0" Height="32"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="ServerOnlineMode" Content="开启正版验证（正版账号专用）"
                                                      Foreground="{DynamicResource InkDim}" Margin="0,12,0,0" FontSize="11.5"/>
                                            <CheckBox x:Name="ServerEula" Content="我已阅读并同意 Minecraft EULA"
                                                      Foreground="{DynamicResource InkDim}" Margin="0,8,0,0" FontSize="11.5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="ServerStartButton" Content="开服" Style="{StaticResource HeroButton}"
                                                        Height="38" Width="92" Click="OnStartServer"/>
                                                <Button x:Name="ServerStopButton" Content="停服" Style="{StaticResource GlassButton}"
                                                        Margin="10,0,0,0" Click="OnStopServer" IsEnabled="False"/>
                                                <Button Content="打开服务端目录" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                                        Click="OnOpenServerFolder"/>
                                            </StackPanel>

                                            <TextBlock x:Name="ServerStatus" Text="未运行" FontSize="11.5" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="樱花穿透" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="在 natfrp.com 建一个 TCP 隧道指向本机端口，然后填访问密钥和隧道 ID。"
                                                       FontSize="11" Foreground="{DynamicResource InkFaint}" Margin="0,5,0,12" TextWrapping="Wrap"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="访问密钥" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                                    <TextBox x:Name="TunnelTokenBox" Height="32" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="隧道 ID（多个用逗号分隔）" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                                    <TextBox x:Name="TunnelIdBox" Height="32" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="TunnelStartButton" Content="启动隧道" Style="{StaticResource GlassButton}"
                                                        Click="OnStartTunnel"/>
                                                <Button x:Name="TunnelStopButton" Content="停止" Style="{StaticResource GlassButton}"
                                                        Margin="10,0,0,0" Click="OnStopTunnel" IsEnabled="False"/>
                                                <Button Content="下载 frpc" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                                        Click="OnEnsureFrpc"/>
                                            </StackPanel>

                                            <TextBlock x:Name="TunnelStatus" Text="未启动" FontSize="11.5" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>

                                            <Border CornerRadius="10" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" Margin="0,10,0,0" Padding="10" Height="150">
                                                <TextBox x:Name="TunnelLog" Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource InkDim}" FontFamily="Consolas" FontSize="11"
                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="本机地址" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="IPv6 是公网地址，朋友可以直接连；IPv4 一般需要穿透或同一局域网。"
                                                       FontSize="11" Foreground="{DynamicResource InkFaint}" Margin="0,5,0,12" TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="端口" FontSize="11.5" Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PortBox" Text="25565" Width="90" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
                                                <Button Content="刷新地址" Style="{StaticResource GlassButton}" Margin="10,0,0,0" Click="OnRefreshAddresses"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="UPnP 开端口" Style="{StaticResource GlassButton}" Click="OnUpnpMap"/>
                                                <Button Content="取消映射" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                                        Click="OnUpnpUnmap"/>
                                            </StackPanel>

                                            <TextBlock x:Name="UpnpStatus" Text="UPnP 没试过：路由器支持的话，IPv4 也能直接连"
                                                       FontSize="11" Foreground="{DynamicResource InkFaint}" Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel x:Name="AddressList" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="服务端控制台" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <Border CornerRadius="10" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" Margin="0,10,0,0" Padding="10" Height="280">
                                                <TextBox x:Name="ServerLog" Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource InkDim}" FontFamily="Consolas" FontSize="11"
                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

</Grid>

                    <!-- ========== 账号页 ========== -->
                    <Grid x:Name="AccountPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="账号" FontSize="32" FontFamily="{DynamicResource FontHead}"
                                       Foreground="{DynamicResource TitleGrad}"/>
                            <TextBlock Text="保存多个账号，随时切换；离线账号也能存好几个" FontSize="12.5"
                                       Foreground="{DynamicResource InkDim}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="380"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AccountList" MaxWidth="620" HorizontalAlignment="Left"/>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="新建离线账号" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="只填一个名字就能用，支持中文和数字" FontSize="11" Foreground="{DynamicResource InkFaint}"
                                                   Margin="0,5,0,10" TextWrapping="Wrap"/>
                                        <TextBox x:Name="OfflineNameBox" Height="34"/>
                                        <Button Content="保存这个离线账号" Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnAddOfflineAccount"/>
                                        <Button Content="导入离线皮肤（PNG）" Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnImportSkin"/>
                                        <TextBlock Text="会用 CustomSkinLoader 把皮肤写进当前版本，装好后进游戏就能看到"
                                                   FontSize="10.5" Foreground="{DynamicResource InkFaint}" Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="登录已有账号" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                        <Button Content="外置登录（LittleSkin）" Style="{StaticResource HeroButton}" Margin="0,12,0,0"
                                                Height="40" Click="OnYggdrasilLogin"/>
                                        <Button x:Name="LoginButton" Content="微软账号登录（等待白名单）" Style="{StaticResource GlassButton}"
                                                Margin="0,10,0,0" Click="OnLogin"/>
                                        <Button Content="微软登录诊断" Style="{StaticResource GlassButton}" Margin="0,8,0,0"
                                                Padding="14,6" FontSize="11" Click="OnMsaDiagnostics"
                                                ToolTip="跑一遍四步：微软账号 → Xbox Live → XSTS → Minecraft Services（第 4 步就是白名单检查）"/>
                                        <Expander Header="高级：Azure ClientId" Margin="0,12,0,0" Foreground="{DynamicResource InkFaint}">
                                            <TextBox x:Name="ClientIdBox" Margin="0,8,0,0"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="皮肤" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock x:Name="AccountSkinName" Text="当前账号" FontSize="12.5"
                                                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="AccountSkinStatus" Text="还没有皮肤" FontSize="10.5"
                                                       Foreground="{DynamicResource InkFaint}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border CornerRadius="10" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" Margin="0,10,0,0" Height="190"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="AccountSkinImage" Stretch="Uniform" Visibility="Collapsed"/>
                                                <wv2:WebView2 x:Name="AccountSkinWeb" DefaultBackgroundColor="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Steve 体型" Style="{StaticResource GlassButton}"
                                                    Padding="12,5" FontSize="11" Tag="false" Click="OnSkinModelToggled"/>
                                            <Button Content="Alex 体型" Style="{StaticResource GlassButton}"
                                                    Padding="12,5" FontSize="11" Margin="8,0,0,0" Tag="true" Click="OnSkinModelToggled"/>
                                        </StackPanel>
                                        <Button x:Name="SkinActionButton" Content="更换这个账号的皮肤"
                                                Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnChangeSkinForCurrent"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="AccountPageStatus" Text="" FontSize="11.5" Margin="4,12,0,0"
                                           Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ========== 设置页 ========== -->
                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="设置" FontSize="32" FontFamily="{DynamicResource FontHead}" Foreground="{DynamicResource TitleGrad}"/>
                            <TextBlock Text="账号、目录、内存、镜像" FontSize="12.5" Foreground="{DynamicResource InkDim}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,0,400,0">
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                                <!-- 界面布局 -->
                                <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="界面布局" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="新版更动感：大胆配色、切换有过渡、导航有高亮胶囊。想安静点就换回经典。"
                                                   FontSize="11.5" Foreground="{DynamicResource InkDim}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="UiLayoutCombo" Height="38" FontSize="12.5"
                                                  SelectionChanged="OnUiLayoutChanged">
                                            <ComboBoxItem Content="新版（动感 / 高对比）" Tag="vivid"/>
                                            <ComboBoxItem Content="终端（荧光绿 / 等宽感）" Tag="terminal"/>
                                            <ComboBoxItem Content="纸质便签（浅色 / 衬线）" Tag="paper"/>
                                            <ComboBoxItem Content="像素 8bit（NES 配色）" Tag="pixel"/>
                                            <ComboBoxItem Content="毛玻璃极光（柔和渐变）" Tag="aurora"/>
                                            <ComboBoxItem Content="经典（旧版布局）" Tag="classic"/>
                                        </ComboBox>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="主题色相" FontSize="11.5" Foreground="{DynamicResource InkDim}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="HueSlider" Grid.Column="1" Minimum="-160" Maximum="160" Value="0"
                                                    Margin="12,0,12,0" VerticalAlignment="Center"
                                                    ValueChanged="OnHueChanged" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                            <TextBlock x:Name="HueText" Grid.Column="2" Text="0°" FontSize="11.5"
                                                       Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" Width="34"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="音效音量" FontSize="11.5" Foreground="{DynamicResource InkDim}"
                                                       VerticalAlignment="Center"/>
                                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="55"
                                                    Margin="12,0,12,0" VerticalAlignment="Center"
                                                    ValueChanged="OnUiVolumeChanged" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                            <TextBlock x:Name="VolumeText" Grid.Column="2" Text="55%" FontSize="11.5"
                                                       Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" Width="34"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>


                                <!-- 下载与来源 -->

                                <!-- 其他 -->

                                <!-- 高级选项 -->



                                <Border CornerRadius="16" Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="游戏" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,10"/>

                                        <TextBlock Text="游戏目录" Foreground="{DynamicResource InkFaint}" FontSize="11"/>
                                        <TextBox x:Name="SettingsGameDir" Margin="0,6,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="最大内存 (MB)" Foreground="{DynamicResource InkFaint}" FontSize="11"/>
                                                <TextBox x:Name="SettingsMemory" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
