<Window x:Class="Aurora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MEME Launcher" Height="800" Width="1280"
        MinHeight="620" MinWidth="1040"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#070A12"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="AppBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF05070D" Offset="0"/>
            <GradientStop Color="#FF0A1020" Offset="0.55"/>
            <GradientStop Color="#FF070A12" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF5B8CFF" Offset="0"/>
            <GradientStop Color="#FF7C5CFF" Offset="0.6"/>
            <GradientStop Color="#FF22D3EE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFB9C8FF" Offset="0.6"/>
            <GradientStop Color="#FF7C5CFF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="Glass" Color="#B3121620"/>
        <SolidColorBrush x:Key="GlassLine" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#FFE6EAF2"/>
        <SolidColorBrush x:Key="InkDim" Color="#FF99A2B5"/>
        <SolidColorBrush x:Key="InkFaint" Color="#FF6D7588"/>
        <FontFamily x:Key="FontHead">Microsoft YaHei UI Light</FontFamily>
        <FontFamily x:Key="FontNum">Segoe UI Variable Display</FontFamily>

        <!-- 窗口按钮 -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource InkDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航 -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow" CornerRadius="30" Background="{StaticResource AccentGrad}"
                                    Opacity="0.38" Margin="-5">
                                <Border.Effect>
                                    <BlurEffect Radius="18"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="b" CornerRadius="30" Background="{StaticResource AccentGrad}" TextElement.Foreground="{TemplateBinding Foreground}">
                                <Border Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="glow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮 -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{StaticResource GlassLine}" BorderThickness="1"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5B8CFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#40FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑条（进度 / 音量） -->
        <Style x:Key="TrackSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource AccentGrad}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="18" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#FFFFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌单条目 -->
        <Style x:Key="TrackItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="10" Background="Transparent" Padding="8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2A44"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5B8CFF"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 版本卡片 -->
        <Style x:Key="VersionTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Width="224" CornerRadius="14" Background="#0EFFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="14,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1.6"/>
                                <Setter TargetName="b" Property="Background" Value="#1E2A44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 滚动条：深色细条 -->
        <Style x:Key="MemeScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#38FFFFFF" CornerRadius="3" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MemeScrollBar}"/>

        <!-- 下拉框：深色 -->
        <Style x:Key="MemeComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#335B8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MemeComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#12FFFFFF" BorderBrush="#26FFFFFF"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="12,0,6,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                <Path Grid.Column="1" Data="M0,0 L4.5,4.5 L9,0" Stroke="#8C94A8"
                                                      StrokeThickness="1.4" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1CFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#FF141A26" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Margin="0,6,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <!-- 背景 -->
        <Border Background="{StaticResource AppBg}"/>

        <!-- 极光色块 -->
        <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-380,-260,0" Opacity="0.55" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#665B8CFF" Offset="0"/>
                    <GradientStop Color="#005B8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-300,0,0,-320" Opacity="0.45" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#557C5CFF" Offset="0"/>
                    <GradientStop Color="#007C5CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 粒子 -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGrad}">
                        <TextBlock Text="M" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MEME" FontWeight="Bold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="LAUNCHER" FontSize="10" Margin="7,1,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource InkFaint}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border CornerRadius="10" Background="#12FFFFFF" Padding="10,5" Margin="0,0,10,0"
                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF4ADE80" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="AccountChip" Text="离线：Steve" FontSize="11.5"
                                       Foreground="{StaticResource InkDim}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" Content="—" FontSize="12"/>
                    <Button Style="{StaticResource ChromeButton}" Click="OnCloseWindow" Content="✕" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- ===== 主体 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 导航栏 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,40">
                    <Button x:Name="NavLaunch" Style="{StaticResource RailButton}" Tag="0" Click="OnNavClick">
                        <StackPanel>
                            <TextBlock Text="◈" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="启动" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavContent" Style="{StaticResource RailButton}" Tag="2" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="▦" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="内容" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavVersions" Style="{StaticResource RailButton}" Tag="7" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="❖" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="版本" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavOnline" Style="{StaticResource RailButton}" Tag="6" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="⇄" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="联机" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavFun" Style="{StaticResource RailButton}" Tag="8" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="♫" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="娱乐" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAccount" Style="{StaticResource RailButton}" Tag="3" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="账号" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource RailButton}" Tag="4" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="⚙" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="设置" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 页面 -->
                <Grid Grid.Column="1" Margin="10,0,22,0">

                    <!-- ========== 主页 ========== -->
                    <Grid x:Name="LaunchPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" CornerRadius="12"
                                Background="#1E2A44" BorderBrush="#505B8CFF" BorderThickness="1"
                                Padding="14,10" Margin="26,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⇪" FontSize="15" Foreground="#FF8AB4FF" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="UpdateBannerText" Text="发现新版本" FontSize="12.5"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="查看更新" HorizontalAlignment="Right" Style="{StaticResource GlassButton}"
                                        Padding="12,5" FontSize="11.5" Click="OnOpenUpdate"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：版本信息 + 启动 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="26,0,0,10">
                                <TextBlock Text="CURRENT VERSION" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="BigVersion" Text="—" FontSize="62" FontFamily="{StaticResource FontNum}"
                                           FontWeight="SemiBold" Foreground="{StaticResource TitleGrad}"/>
                                <TextBlock x:Name="DetName" Text="选择一个版本" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetMeta" Text="—" FontSize="12" Foreground="{StaticResource InkDim}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Border CornerRadius="9" Background="#10FFFFFF" BorderBrush="{StaticResource GlassLine}"
                                            BorderThickness="1" Padding="12,7" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="JAVA" FontSize="9.5" Foreground="{StaticResource InkFaint}"/>
                                            <TextBlock x:Name="DetJava" Text="—" FontSize="11.5" Foreground="{StaticResource Ink}"
                                                       Margin="0,2,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="9" Background="#10FFFFFF" BorderBrush="{StaticResource GlassLine}"
                                            BorderThickness="1" Padding="12,7" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="MODS" FontSize="9.5" Foreground="{StaticResource InkFaint}"/>
                                            <TextBlock x:Name="DetMods" Text="—" FontSize="11.5" Foreground="{StaticResource Ink}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="9" Background="#10FFFFFF" BorderBrush="{StaticResource GlassLine}"
                                            BorderThickness="1" Padding="12,7">
                                        <StackPanel>
                                            <TextBlock Text="内存" FontSize="9.5" Foreground="{StaticResource InkFaint}"/>
                                            <TextBlock x:Name="DetMemory" Text="—" FontSize="11.5" Foreground="{StaticResource Ink}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Button x:Name="LaunchButton" Style="{StaticResource HeroButton}" Width="286" Height="60"
                                        Margin="0,30,0,0" Click="OnLaunch" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                        <TextBlock Text="开始游戏" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ForceKillButton" Content="强制关闭游戏" Style="{StaticResource GlassButton}"
                                        Height="32" Margin="0,10,0,0" Visibility="Collapsed" Click="OnForceKillGame"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="打开目录" Style="{StaticResource GlassButton}" Click="OnOpenFolder"
                                            FontSize="11.5" Padding="12,6"/>
                                    <TextBlock x:Name="DetDir" Text="" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="330"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 右：3D -->
                            <Grid Grid.Column="1" Margin="0,-10,-10,0" IsHitTestVisible="False">
                                <Viewport3D x:Name="HeroViewport" Opacity="0.98">
                                    <Viewport3D.Effect>
                                        <DropShadowEffect Color="#5B8CFF" BlurRadius="60" ShadowDepth="0" Opacity="0.35"/>
                                    </Viewport3D.Effect>
                                </Viewport3D>
                            </Grid>
                        </Grid>

                        <!-- 版本轮播 -->
                        <StackPanel Grid.Row="2" Margin="26,0,0,6">
                            <Grid Margin="0,0,0,4">
                                <Button x:Name="VersionPickerButton" HorizontalAlignment="Left"
                                        Style="{StaticResource GlassButton}" Padding="14,7" Click="OnPickVersion">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="版本" FontSize="11" Foreground="{StaticResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="VersionPickerText" Text="未选择" FontSize="12"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                   MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="▾" FontSize="10" Foreground="{StaticResource InkFaint}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="VersionPopover" PlacementTarget="{Binding ElementName=VersionPickerButton}"
                                       Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border CornerRadius="14" Background="#F2141A24" BorderBrush="#3A5B8CFF"
                                            BorderThickness="1" Padding="6" Margin="0,0,0,8" Width="380">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="VersionPopoverList"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="版本管理" Style="{StaticResource GlassButton}" Padding="12,4" FontSize="11"
                                            Click="OnOpenVersionManager"/>
                                    <Button Content="导入整合包" Style="{StaticResource GlassButton}" Padding="12,4" FontSize="11"
                                            Margin="8,0,0,0" Click="OnImportPackHome"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0" Height="0" Visibility="Collapsed"
                                     PreviewMouseWheel="OnVersionWheel"
                                     ItemContainerStyle="{StaticResource VersionTile}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnVersionSelected">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="3" Height="14" CornerRadius="2" Background="{Binding LoaderColor}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ShortName}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                                           Width="168"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="11,5,0,0"
                                                       Foreground="{StaticResource InkDim}" TextTrimming="CharacterEllipsis"
                                                       Width="198"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>

                    <!-- ========== 安装页 ========== -->
                    <Grid x:Name="InstallPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="内容" FontSize="32" FontFamily="{StaticResource FontHead}" Foreground="{StaticResource TitleGrad}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="安装版本" Style="{StaticResource HeroButton}" Height="34" Width="110" Padding="0" Click="OnTabInstall"/>
                                <Button Content="内容下载" Style="{StaticResource GlassButton}" Height="34" Width="110" Padding="0"
                                        Margin="10,0,0,0" Click="OnTabContent"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource Glass}"
                                    BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="12,10,10,8">
                                        <TextBlock Text="Minecraft 正式版" FontSize="11.5" Foreground="{StaticResource InkFaint}"/>
                                        <Grid Margin="0,8,0,0">
                                            <TextBox x:Name="VersionSearchBox" Height="30" Padding="9,6,9,6"
                                                     TextChanged="OnVersionSearch"/>
                                            <TextBlock x:Name="VersionSearchHint" Text="搜索版本号，如 1.21 / 26.2"
                                                       IsHitTestVisible="False" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11.5"
                                                       Foreground="{StaticResource InkFaint}"/>
                                        </Grid>
                                    </StackPanel>
                                    <ListBox x:Name="McVersionList" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource Ink}" SelectionChanged="OnMcVersionSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,5">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding ReleaseTime}" FontSize="10.5"
                                                               Foreground="{StaticResource InkFaint}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="22,18">
                                    <StackPanel>
                                        <TextBlock x:Name="InstallMcText" Text="先在左边选一个 Minecraft 版本"
                                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="加载器会安装到上面这个版本之上；原版会自动补齐。"
                                                   FontSize="11.5" Foreground="{StaticResource InkDim}"
                                                   Margin="0,7,0,18" TextWrapping="Wrap"/>

                                        <TextBlock Text="加载器" FontSize="11" Foreground="{StaticResource InkFaint}"/>
                                        <ComboBox x:Name="LoaderCombo" Margin="0,6,0,14" SelectedIndex="0"
                                                  SelectionChanged="OnLoaderChanged">
                                            <ComboBoxItem Content="原版（不装加载器）"/>
                                            <ComboBoxItem Content="Fabric"/>
                                            <ComboBoxItem Content="NeoForge"/>
                                            <ComboBoxItem Content="Forge"/>
                                        </ComboBox>

                                        <TextBlock Text="加载器版本" FontSize="11" Foreground="{StaticResource InkFaint}"/>
                                        <ComboBox x:Name="LoaderVersionCombo" Margin="0,6,0,0" IsEnabled="False"/>
                                        <TextBlock x:Name="LoaderHint" Text="选了加载器后会自动拉取可用版本" FontSize="10.5"
                                                   Foreground="{StaticResource InkFaint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="InstallButton" Content="开始安装" Style="{StaticResource HeroButton}"
                                        Height="52" Margin="0,16,0,0" Click="OnInstall" IsEnabled="False"/>

                                <ProgressBar x:Name="InstallBar" Height="5" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                             Foreground="{StaticResource AccentGrad}" Background="#1AFFFFFF" BorderThickness="0"/>
                                <TextBlock x:Name="InstallText" Text="等待选择" FontSize="11.5" Margin="0,8,0,0"
                                           Foreground="{StaticResource InkDim}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ========== 内容页 ========== -->
                    <Grid x:Name="ContentPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="内容" FontSize="32" FontFamily="{StaticResource FontHead}" Foreground="{StaticResource TitleGrad}"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="安装版本" Style="{StaticResource GlassButton}" Height="34" Width="110"
                                            Padding="0" Click="OnTabInstall"/>
                                    <Button Content="内容下载" Style="{StaticResource HeroButton}" Height="34" Width="110"
                                            Padding="0" Margin="10,0,0,0" Click="OnTabContent"/>
                                </StackPanel>
                                <Button x:Name="DownloadsButton" Content="下载管理" HorizontalAlignment="Right"
                                        Style="{StaticResource GlassButton}" Height="34" Click="OnToggleDownloads"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="KindCombo" Width="110" SelectedIndex="0" SelectionChanged="OnKindChanged">
                                        <ComboBoxItem Content="模组"/>
                                        <ComboBoxItem Content="整合包"/>
                                        <ComboBoxItem Content="光影"/>
                                        <ComboBoxItem Content="资源包"/>
                                    </ComboBox>
                                    <ComboBox x:Name="SourceCombo" Width="132" Margin="8,0,0,0" SelectedIndex="0"
                                              SelectionChanged="OnSourceChanged">
                                        <ComboBoxItem Content="Modrinth"/>
                                        <ComboBoxItem Content="CurseForge"/>
                                    </ComboBox>
                                    <ComboBox x:Name="VersionCombo" Width="128" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="ContentLoaderCombo" Width="112" Margin="8,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="任意加载器"/>
                                        <ComboBoxItem Content="fabric"/>
                                        <ComboBoxItem Content="forge"/>
                                        <ComboBoxItem Content="neoforge"/>
                                        <ComboBoxItem Content="quilt"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CategoryCombo" Width="150" Margin="8,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Grid Width="300">
                                        <TextBox x:Name="QueryBox" VerticalContentAlignment="Center" Padding="9,6,9,6"
                                                 TextChanged="OnQueryTextChanged"/>
                                        <TextBlock x:Name="QueryHint" Text="搜索模组 / 整合包 / 光影 / 资源包"
                                                   IsHitTestVisible="False" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11.5"
                                                   Foreground="{StaticResource InkFaint}"/>
                                    </Grid>
                                    <Button Content="搜索" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="OnSearch"/>

                                    <TextBlock x:Name="PageText" Text="" FontSize="11.5" Margin="18,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource InkFaint}"/>
                                    <Button x:Name="PrevButton" Content="‹ 上一页" Style="{StaticResource GlassButton}"
                                            Margin="10,0,0,0" Padding="12,6" FontSize="11.5" Click="OnPrevPage" IsEnabled="False"/>
                                    <Button x:Name="NextButton" Content="下一页 ›" Style="{StaticResource GlassButton}"
                                            Margin="6,0,0,0" Padding="12,6" FontSize="11.5" Click="OnNextPage" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" CornerRadius="16" Background="{StaticResource Glass}"
                                    BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="6">
                                <ListBox x:Name="ContentList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Ink}" SelectionChanged="OnContentSelected"
                                         PreviewMouseLeftButtonUp="OnContentListClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <EventSetter Event="MouseLeftButtonUp" Handler="OnContentItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="44" Height="44" CornerRadius="10" Background="#14FFFFFF"
                                                        VerticalAlignment="Top">
                                                    <Grid>
                                                        <TextBlock Text="▦" FontSize="15" Foreground="{StaticResource InkFaint}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Icon}" Width="44" Height="44"
                                                               Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13.5" Foreground="{StaticResource Ink}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,4,0,0"
                                                               LineHeight="17" Foreground="{StaticResource InkDim}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Meta}" FontSize="10.5" Margin="0,4,0,0"
                                                               Foreground="{StaticResource InkFaint}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="26,12,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="FileCombo" Grid.Column="0" DisplayMemberPath="Label"
                                          SelectionChanged="OnFileSelected"/>
                                <Button x:Name="ContentInstallButton" Grid.Column="1" Content="安装到当前版本"
                                        Style="{StaticResource HeroButton}" Click="OnInstallContent"
                                        Margin="10,0,0,0" Padding="22,0" MinWidth="150" Height="38" IsEnabled="False"/>
                            </Grid>
                            <TextBlock Grid.Row="1" x:Name="ContentStatus" Text="搜索后选一个条目" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{StaticResource InkDim}" TextWrapping="Wrap"/>
                        </Grid>
                        <!-- 下载管理抽屉 -->
                        <Border x:Name="DownloadPanel" Visibility="Collapsed" Width="420" HorizontalAlignment="Right"
                                Margin="0,10,16,16" CornerRadius="16" Background="#F210141C"
                                BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="下载管理" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="打开目录" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11"
                                                Click="OnOpenDownloadFolder"/>
                                        <Button Content="清空已结束" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11"
                                                Margin="6,0,0,0" Click="OnClearDownloads"/>
                                        <Button Content="✕" Style="{StaticResource GlassButton}" Padding="8,4" FontSize="11"
                                                Margin="6,0,0,0" Click="OnToggleDownloads"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DownloadList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Background="#12FFFFFF" Padding="12,10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                                   Foreground="{StaticResource InkFaint}" Margin="0,3,0,6"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                                     Background="#1AFFFFFF" Foreground="{StaticResource AccentGrad}"
                                                                     BorderThickness="0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="暂停" Style="{StaticResource GlassButton}"
                                                                    Padding="10,3" FontSize="10.5" Click="OnPauseDownload"/>
                                                            <Button Content="继续" Style="{StaticResource GlassButton}"
                                                                    Padding="10,3" FontSize="10.5" Margin="6,0,0,0" Click="OnResumeDownload"/>
                                                            <Button Content="取消" Style="{StaticResource GlassButton}"
                                                                    Padding="10,3" FontSize="10.5" Margin="6,0,0,0" Click="OnCancelDownload"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="2" x:Name="DownloadEmptyHint" Text="还没有下载任务"
                                           FontSize="11" Foreground="{StaticResource InkFaint}" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 内容详情浮层 -->
                        <Grid x:Name="ContentDetailPanel" Grid.RowSpan="3" Visibility="Collapsed"
                              Background="#F20B0E13">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="26,16,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="‹ 返回" Style="{StaticResource GlassButton}" Click="OnCloseContentDetail"/>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#14FFFFFF" Margin="16,0,0,0">
                                        <Image x:Name="DetailIcon" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock x:Name="DetailTitle" Text="" FontSize="22" FontFamily="{StaticResource FontHead}"
                                               Foreground="{StaticResource Ink}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" Margin="26,0,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,24">
                                    <TextBlock x:Name="DetailSummary" Text="" FontSize="12.5"
                                               Foreground="{StaticResource InkDim}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailStatus" Text="" FontSize="11.5" Margin="0,8,0,0"
                                               Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="DetailBody" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <!-- ========== 版本管理 ========== -->
                    <Grid x:Name="VersionsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="版本" FontSize="32" FontFamily="{StaticResource FontHead}"
                                       Foreground="{StaticResource TitleGrad}"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="VmDirCombo" Width="520" Height="32"
                                              SelectionChanged="OnVmDirChanged"/>
                                    <Button Content="添加文件夹" Style="{StaticResource GlassButton}" Height="32" Margin="10,0,0,0"
                                            Click="OnVmAddDir"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource Glass}"
                                    BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="已安装版本" FontSize="11.5"
                                               Foreground="{StaticResource InkFaint}" Margin="12,10,10,8"/>
                                    <ListBox x:Name="VmVersionList" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource Ink}" SelectionChanged="OnVmVersionSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,5">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                               Foreground="{StaticResource InkFaint}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,16,0">

                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock x:Name="VmTitle" Text="先在左边选一个版本" FontSize="18"
                                                       FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock x:Name="VmPath" Text="" FontSize="11" Margin="0,6,0,0"
                                                       Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <TextBlock Text="运行内存 (MB)" FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkDim}"/>
                                                <TextBox x:Name="VmMemoryBox" Width="110" Margin="10,0,0,0"
                                                         HorizontalContentAlignment="Center"/>
                                                <Button Content="应用" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                                        Click="OnVmSaveMemory"/>
                                                <Button Content="打开版本目录" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                                        Click="OnVmOpenVersionDir"/>
                                                <Button Content="设为安装目标" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                                        Click="OnVmSetAsTarget"/>
                                            </StackPanel>

                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="mods" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="mods" Click="OnVmOpenFolder"/>
                                                <Button Content="saves（地图）" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="saves" Click="OnVmOpenFolder"/>
                                                <Button Content="resourcepacks" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="resourcepacks" Click="OnVmOpenFolder"/>
                                                <Button Content="shaderpacks" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                        Tag="shaderpacks" Click="OnVmOpenFolder"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="模组" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="添加 mod" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                            Click="OnVmAddMods"/>
                                                    <Button Content="刷新" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="11"
                                                            Margin="8,0,0,0" Click="OnVmRefreshMods"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="可以直接把 .jar 拖进来；点开关启用/禁用（改扩展名，不删文件）"
                                                       FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,6,0,10"/>
                                            <Grid Margin="0,0,0,10">
                                                <TextBox x:Name="VmModSearch" Height="30" Padding="9,6,9,6"
                                                         TextChanged="OnVmModSearch"/>
                                                <TextBlock x:Name="VmModSearchHint" Text="搜索模组文件名"
                                                           IsHitTestVisible="False" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{StaticResource InkFaint}"/>
                                            </Grid>

                                            <Border CornerRadius="10" Background="#0B0E13" Padding="10"
                                                    AllowDrop="True" Drop="OnVmModsDrop" DragOver="OnVmModsDragOver">
                                                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="VmModList"/>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="整合包" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="把这个版本的 mods / config / options.txt 打成一个 zip，别人导入就能玩"
                                                       FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,6,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="导出整合包" Style="{StaticResource HeroButton}" Height="36" Width="150"
                                                        Click="OnVmExportPack"/>
                                                <Button Content="导入整合包" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                                        Click="OnVmImportPack"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="VmStatus" Text="" FontSize="11.5" Margin="4,12,0,20"
                                               Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ========== 联机页 ========== -->
                    <Grid x:Name="OnlinePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="联机" FontSize="32" FontFamily="{StaticResource FontHead}"
                                       Foreground="{StaticResource TitleGrad}"/>
                            <TextBlock Text="一键开服，然后把地址发给朋友；没有公网 IP 就用樱花穿透" FontSize="12.5"
                                       Foreground="{StaticResource InkDim}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="一键开服" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                                <Button Content="开服教程" HorizontalAlignment="Right" Style="{StaticResource GlassButton}"
                                                        Padding="10,4" FontSize="11" Click="OnOpenServerGuide"/>
                                            </Grid>
                                            <TextBlock Text="用已安装的版本起服务端：原版 / Fabric / Forge / NeoForge 都行。"
                                                       FontSize="11" Foreground="{StaticResource InkFaint}" Margin="0,5,0,12"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="版本" FontSize="11" Foreground="{StaticResource InkDim}"/>
                                            <ComboBox x:Name="ServerVersionCombo" Margin="0,6,0,10" Height="34"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="端口" FontSize="11" Foreground="{StaticResource InkDim}"/>
                                                    <TextBox x:Name="ServerPortBox" Text="25565" Margin="0,6,0,0" Height="32"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="内存 (MB)" FontSize="11" Foreground="{StaticResource InkDim}"/>
                                                    <TextBox x:Name="ServerMemoryBox" Text="2048" Margin="0,6,0,0" Height="32"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="ServerOnlineMode" Content="开启正版验证（正版账号专用）"
                                                      Foreground="{StaticResource InkDim}" Margin="0,12,0,0" FontSize="11.5"/>
                                            <CheckBox x:Name="ServerEula" Content="我已阅读并同意 Minecraft EULA"
                                                      Foreground="{StaticResource InkDim}" Margin="0,8,0,0" FontSize="11.5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="ServerStartButton" Content="开服" Style="{StaticResource HeroButton}"
                                                        Height="38" Width="92" Click="OnStartServer"/>
                                                <Button x:Name="ServerStopButton" Content="停服" Style="{StaticResource GlassButton}"
                                                        Margin="10,0,0,0" Click="OnStopServer" IsEnabled="False"/>
                                                <Button Content="打开服务端目录" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                                        Click="OnOpenServerFolder"/>
                                            </StackPanel>

                                            <TextBlock x:Name="ServerStatus" Text="未运行" FontSize="11.5" Margin="0,10,0,0"
                                                       Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="樱花穿透" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="在 natfrp.com 建一个 TCP 隧道指向本机端口，然后填访问密钥和隧道 ID。"
                                                       FontSize="11" Foreground="{StaticResource InkFaint}" Margin="0,5,0,12" TextWrapping="Wrap"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="访问密钥" FontSize="11" Foreground="{StaticResource InkDim}"/>
                                                    <TextBox x:Name="TunnelTokenBox" Height="32" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="隧道 ID（多个用逗号分隔）" FontSize="11" Foreground="{StaticResource InkDim}"/>
                                                    <TextBox x:Name="TunnelIdBox" Height="32" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="TunnelStartButton" Content="启动隧道" Style="{StaticResource GlassButton}"
                                                        Click="OnStartTunnel"/>
                                                <Button x:Name="TunnelStopButton" Content="停止" Style="{StaticResource GlassButton}"
                                                        Margin="10,0,0,0" Click="OnStopTunnel" IsEnabled="False"/>
                                                <Button Content="下载 frpc" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                                        Click="OnEnsureFrpc"/>
                                            </StackPanel>

                                            <TextBlock x:Name="TunnelStatus" Text="未启动" FontSize="11.5" Margin="0,10,0,0"
                                                       Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>

                                            <Border CornerRadius="10" Background="#0B0E13" Margin="0,10,0,0" Padding="10" Height="150">
                                                <TextBox x:Name="TunnelLog" Background="Transparent" BorderThickness="0"
                                                         Foreground="#FF9AA6BA" FontFamily="Consolas" FontSize="11"
                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="本机地址" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="IPv6 是公网地址，朋友可以直接连；IPv4 一般需要穿透或同一局域网。"
                                                       FontSize="11" Foreground="{StaticResource InkFaint}" Margin="0,5,0,12" TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="端口" FontSize="11.5" Foreground="{StaticResource InkDim}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PortBox" Text="25565" Width="90" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
                                                <Button Content="刷新地址" Style="{StaticResource GlassButton}" Margin="10,0,0,0" Click="OnRefreshAddresses"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="UPnP 开端口" Style="{StaticResource GlassButton}" Click="OnUpnpMap"/>
                                                <Button Content="取消映射" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                                        Click="OnUpnpUnmap"/>
                                            </StackPanel>

                                            <TextBlock x:Name="UpnpStatus" Text="UPnP 没试过：路由器支持的话，IPv4 也能直接连"
                                                       FontSize="11" Foreground="{StaticResource InkFaint}" Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel x:Name="AddressList" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="16" Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="服务端控制台" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <Border CornerRadius="10" Background="#0B0E13" Margin="0,10,0,0" Padding="10" Height="280">
                                                <TextBox x:Name="ServerLog" Background="Transparent" BorderThickness="0"
                                                         Foreground="#FF9AA6BA" FontFamily="Consolas" FontSize="11"
                                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

</Grid>

                    <!-- ========== 账号页 ========== -->
                    <Grid x:Name="AccountPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="账号" FontSize="32" FontFamily="{StaticResource FontHead}"
                                       Foreground="{StaticResource TitleGrad}"/>
                            <TextBlock Text="保存多个账号，随时切换；离线账号也能存好几个" FontSize="12.5"
                                       Foreground="{StaticResource InkDim}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="380"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AccountList" MaxWidth="620" HorizontalAlignment="Left"/>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="新建离线账号" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="只填一个名字就能用，支持中文和数字" FontSize="11" Foreground="{StaticResource InkFaint}"
                                                   Margin="0,5,0,10" TextWrapping="Wrap"/>
                                        <TextBox x:Name="OfflineNameBox" Height="34"/>
                                        <Button Content="保存这个离线账号" Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnAddOfflineAccount"/>
                                        <Button Content="导入离线皮肤（PNG）" Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnImportSkin"/>
                                        <TextBlock Text="会用 CustomSkinLoader 把皮肤写进当前版本，装好后进游戏就能看到"
                                                   FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="登录已有账号" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <Button Content="外置登录（LittleSkin）" Style="{StaticResource HeroButton}" Margin="0,12,0,0"
                                                Height="40" Click="OnYggdrasilLogin"/>
                                        <Button Content="导入官方启动器账号" Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnImportOfficial"/>
                                        <Button x:Name="LoginButton" Content="微软账号登录（等待白名单）" Style="{StaticResource GlassButton}"
                                                Margin="0,10,0,0" Click="OnLogin"/>
                                        <Expander Header="高级：Azure ClientId" Margin="0,12,0,0" Foreground="{StaticResource InkFaint}">
                                            <TextBox x:Name="ClientIdBox" Margin="0,8,0,0"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="皮肤" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock x:Name="AccountSkinName" Text="当前账号" FontSize="12.5"
                                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="AccountSkinStatus" Text="还没有皮肤" FontSize="10.5"
                                                       Foreground="{StaticResource InkFaint}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border CornerRadius="10" Background="#0B0E13" Margin="0,10,0,0" Height="190"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="AccountSkinImage" Stretch="Uniform" Visibility="Collapsed"/>
                                                <wv2:WebView2 x:Name="AccountSkinWeb" DefaultBackgroundColor="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Steve 体型" Style="{StaticResource GlassButton}"
                                                    Padding="12,5" FontSize="11" Tag="false" Click="OnSkinModelToggled"/>
                                            <Button Content="Alex 体型" Style="{StaticResource GlassButton}"
                                                    Padding="12,5" FontSize="11" Margin="8,0,0,0" Tag="true" Click="OnSkinModelToggled"/>
                                        </StackPanel>
                                        <Button Content="更换这个账号的皮肤" Style="{StaticResource GlassButton}" Margin="0,10,0,0"
                                                Click="OnChangeSkinForCurrent"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="AccountPageStatus" Text="" FontSize="11.5" Margin="4,12,0,0"
                                           Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ========== 设置页 ========== -->
                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="设置" FontSize="32" FontFamily="{StaticResource FontHead}" Foreground="{StaticResource TitleGrad}"/>
                            <TextBlock Text="账号、目录、内存、镜像" FontSize="12.5" Foreground="{StaticResource InkDim}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,0,0,0">
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left">

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="账号" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock x:Name="AccountStatus" Text="当前：离线账号" FontSize="11.5"
                                                   Foreground="{StaticResource InkDim}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                        <Button Content="打开账号管理" Style="{StaticResource HeroButton}" Width="150" Height="38"
                                                Click="OnOpenAccounts"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="游戏" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,10"/>

                                        <TextBlock Text="游戏目录" Foreground="{StaticResource InkFaint}" FontSize="11"/>
                                        <TextBox x:Name="SettingsGameDir" Margin="0,6,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="离线玩家名" Foreground="{StaticResource InkFaint}" FontSize="11"/>
                                                <TextBox x:Name="SettingsPlayer" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="最大内存 (MB)" Foreground="{StaticResource InkFaint}" FontSize="11"/>
                                                <TextBox x:Name="SettingsMemory" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Java 路径（留空自动匹配）" Foreground="{StaticResource InkFaint}" FontSize="11" Margin="0,14,0,0"/>
                                        <TextBox x:Name="SettingsJava" Margin="0,6,0,0"/>

                                        <TextBlock Text="版本隔离" Foreground="{StaticResource InkFaint}" FontSize="11" Margin="0,14,0,0"/>
                                        <ComboBox x:Name="SettingsIsolation" Margin="0,6,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="auto（推荐）"/>
                                            <ComboBoxItem Content="on（总是隔离）"/>
                                            <ComboBoxItem Content="off（共用根目录）"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="下载与镜像" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="SettingsMirror" Content="下载走国内镜像 (BMCLAPI)"
                                                  Foreground="{StaticResource Ink}" IsChecked="True"/>
                                        <CheckBox x:Name="SettingsAskInstall" Content="安装 mod / 光影前询问装到哪个目录"
                                                  Foreground="{StaticResource Ink}" Margin="0,10,0,0" IsChecked="True"/>
                                        <TextBlock Text="自建镜像站地址（留空则直接用 BMCLAPI）" Foreground="{StaticResource InkFaint}"
                                                   FontSize="11" Margin="0,14,0,0"/>
                                        <TextBox x:Name="SettingsMirrorUrl" Margin="0,6,0,0"/>
                                        <TextBlock Text="CurseForge API key（可选，填了才能搜 CurseForge）"
                                                   Foreground="{StaticResource InkFaint}" FontSize="11" Margin="0,14,0,0"/>
                                        <TextBox x:Name="SettingsCfKey" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="关于与更新" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock x:Name="VersionText" Text="当前版本 v0.5.1" FontSize="11.5"
                                                   Foreground="{StaticResource InkDim}" Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="检查更新" Style="{StaticResource GlassButton}" Click="OnCheckUpdates"/>
                                            <Button Content="查看更新日志" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                                                    Click="OnOpenUpdatesPage"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateStatus" Text="" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                                    <Button Content="保存设置" Style="{StaticResource HeroButton}" Click="OnSaveSettings"
                                            Padding="22,0" Height="40"/>
                                    <TextBlock x:Name="SaveStatus" Margin="14,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource InkDim}" FontSize="11.5"/>
                                </StackPanel>

                                <Border CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="22,18"
                                        Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="78" Height="78" CornerRadius="39" Background="{StaticResource AccentGrad}"
                                                VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#5B8CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                                            </Border.Effect>
                                            <Border CornerRadius="36" Margin="3" Background="#FF0B0E13">
                                                <Image Source="/Assets/brand/avatar.jpg" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="FOR STONEFISH8" FontSize="21" FontWeight="Bold"
                                                       FontFamily="{StaticResource FontHead}"
                                                       Foreground="{StaticResource TitleGrad}"/>
                                            <TextBlock Text="石余制作" FontSize="13" Foreground="{StaticResource InkDim}"
                                                       Margin="0,7,0,0"/>
                                            <TextBlock Text="MAKE WITH LOVE" FontSize="10" Foreground="{StaticResource InkFaint}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="我的 B 站主页 ↗" Style="{StaticResource GlassButton}"
                                                VerticalAlignment="Center" Margin="16,0,0,0" Click="OnOpenBiliSpace"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <!-- ========== 更新日志 ========== -->
                    <Grid x:Name="UpdatesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <Grid>
                                <TextBlock Text="更新日志" FontSize="32" FontFamily="{StaticResource FontHead}" Foreground="{StaticResource TitleGrad}"/>
                                <Button Content="← 返回设置" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource GlassButton}" Click="OnBackToSettings"/>
                            </Grid>
                            <TextBlock x:Name="UpdateSubtitle" Text="每次发版，预览图会跟着版本一起进来"
                                       FontSize="12.5" Foreground="{StaticResource InkDim}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,0,0,0">
                            <StackPanel x:Name="UpdateList" MaxWidth="780" HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== 娱乐页 ========== -->
                    <Grid x:Name="FunPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,6,0,14">
                            <TextBlock Text="娱乐" FontSize="32" FontFamily="{StaticResource FontHead}"
                                       Foreground="{StaticResource TitleGrad}"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FunTabBili" Content="哔哩哔哩" Style="{StaticResource HeroButton}"
                                            Height="34" Width="104" Padding="0" Click="OnFunTab"/>
                                    <Button x:Name="FunTabMusic" Content="音乐" Style="{StaticResource GlassButton}"
                                            Height="34" Width="104" Padding="0" Margin="10,0,0,0" Click="OnFunTab"/>
                                </StackPanel>
                                <TextBlock x:Name="FunStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11.5" Foreground="{StaticResource InkFaint}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="26,0,0,0">

                            <!-- 哔哩哔哩 -->
                            <Grid x:Name="BiliPane">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="←" Style="{StaticResource GlassButton}" Width="38" Height="30"
                                            Padding="0" FontSize="12" Click="OnBiliBack" ToolTip="后退"/>
                                    <Button Content="→" Style="{StaticResource GlassButton}" Width="36" Height="28"
                                            Padding="0" FontSize="12" Margin="6,0,0,0" Click="OnBiliForward" ToolTip="前进"/>
                                    <Button Content="⟳" Style="{StaticResource GlassButton}" Width="36" Height="28"
                                            Padding="0" FontSize="13" Margin="6,0,0,0" Click="OnBiliReload" ToolTip="刷新"/>
                                    <Button Content="首页" Style="{StaticResource GlassButton}" Height="28"
                                            Padding="12,0" FontSize="11" Margin="6,0,0,0" Click="OnBiliHome"/>
                                    <Button Content="－" Style="{StaticResource GlassButton}" Width="30" Height="28"
                                            Padding="0" FontSize="12" Margin="12,0,0,0" Click="OnBiliZoomOut"
                                            ToolTip="缩小网页"/>
                                    <Button Content="＋" Style="{StaticResource GlassButton}" Width="30" Height="28"
                                            Padding="0" FontSize="12" Margin="4,0,0,0" Click="OnBiliZoomIn"
                                            ToolTip="放大网页"/>
                                    <Button Content="适应" Style="{StaticResource GlassButton}" Height="28"
                                            Padding="10,0" FontSize="11" Margin="4,0,0,0" Click="OnBiliZoomFit"
                                            ToolTip="让整页宽度铺满窗口"/>
                                    <TextBlock x:Name="BiliZoomText" Text="100%" FontSize="10.5"
                                               Foreground="{StaticResource InkFaint}" VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                    <TextBlock x:Name="BiliUrl" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                               VerticalAlignment="Center" Margin="14,0,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                </StackPanel>

                                <Border Grid.Row="1" CornerRadius="14" Background="#FF0B0E13"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" ClipToBounds="True"
                                        SizeChanged="OnBiliSizeChanged">
                                    <Grid>
                                        <wv2:WebView2 x:Name="BiliWeb" DefaultBackgroundColor="#FF0B0E13"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2" x:Name="BiliHint"
                                           Text="第一次进来自动加载 B 站，登录一下就能看番；播放器声音走系统音量"
                                           FontSize="10.5" Foreground="{StaticResource InkFaint}" Margin="2,6,0,12"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <!-- 音乐 -->
                            <Grid x:Name="MusicPane" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="306"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="添加音乐" Style="{StaticResource HeroButton}"
                                                        Height="30" Padding="14,0" FontSize="11.5" Click="OnMusicAdd"/>
                                                <Button Content="添加文件夹" Style="{StaticResource GlassButton}"
                                                        Height="30" Padding="12,0" FontSize="11.5" Margin="8,0,0,0"
                                                        Click="OnMusicAddFolder"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PlaylistHint" Text="也可以把音乐文件直接拖进列表"
                                                       FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <ListBox x:Name="SongList" Grid.Row="1" Margin="0,10,0,0"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource Ink}"
                                                 ItemContainerStyle="{StaticResource TrackItem}"
                                                 SelectionChanged="OnSongSelected"
                                                 AllowDrop="True" Drop="OnSongDrop" DragOver="OnSongDragOver"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,6">
                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Sub}" FontSize="10"
                                                                   Foreground="{StaticResource InkFaint}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="清空列表" Style="{StaticResource GlassButton}"
                                                    Padding="10,4" FontSize="10.5" Click="OnMusicClear"/>
                                            <TextBlock x:Name="SongCountText" Text="0 首" FontSize="10.5"
                                                       Foreground="{StaticResource InkFaint}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="16"
                                        Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassLine}"
                                        BorderThickness="1" Padding="20,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock x:Name="NowTitle" Text="还没有选歌" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock x:Name="NowArtist" Text="左边挑一首，或者把音乐拖进来"
                                                           FontSize="11" Foreground="{StaticResource InkFaint}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                <TextBlock x:Name="LyricSource" Text="" FontSize="10"
                                                           Foreground="#FF7FA6FF" Margin="10,1,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ScrollViewer x:Name="LyricScroll" Grid.Row="1" Margin="0,10,0,0"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PanningMode="VerticalOnly">
                                            <StackPanel x:Name="LyricPanel" Margin="2,40,2,60"/>
                                        </ScrollViewer>

                                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                            <Slider x:Name="SeekBar" Style="{StaticResource TrackSlider}"
                                                    Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True"
                                                    ValueChanged="OnSeekChanged"
                                                    Thumb.DragStarted="OnSeekDragStart"
                                                    Thumb.DragCompleted="OnSeekDragEnd"/>
                                            <Grid Margin="2,2,2,0">
                                                <TextBlock x:Name="TimeNow" Text="0:00" FontSize="10.5"
                                                           Foreground="{StaticResource InkFaint}"/>
                                                <TextBlock x:Name="TimeTotal" Text="0:00" FontSize="10.5"
                                                           Foreground="{StaticResource InkFaint}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="◀◀" Style="{StaticResource GlassButton}" Width="54"
                                                            Height="34" Padding="0" FontSize="10" ToolTip="上一首"
                                                            Click="OnMusicPrev"/>
                                                    <Button x:Name="PlayButton" Content="▶" Style="{StaticResource HeroButton}"
                                                            Width="78" Height="34" Margin="8,0,0,0" Padding="0" FontSize="13"
                                                            ToolTip="播放 / 暂停" Click="OnMusicPlayPause"/>
                                                    <Button Content="▶▶" Style="{StaticResource GlassButton}" Width="54"
                                                            Height="34" Padding="0" FontSize="10" Margin="8,0,0,0"
                                                            ToolTip="下一首" Click="OnMusicNext"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="音量" FontSize="10.5"
                                                               Foreground="{StaticResource InkFaint}"
                                                               VerticalAlignment="Center"/>
                                                    <Slider x:Name="VolumeBar" Style="{StaticResource TrackSlider}"
                                                            Width="86" Margin="8,0,0,0" Minimum="0" Maximum="100"
                                                            Value="70" IsMoveToPointEnabled="True"
                                                            ValueChanged="OnVolumeChanged"/>
                                                    <TextBlock x:Name="VolText" Text="70%" FontSize="10.5" Width="34"
                                                               Margin="8,0,0,0" TextAlignment="Right"
                                                               Foreground="{StaticResource InkFaint}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="88,6,26,12">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5"
                           Foreground="{StaticResource InkFaint}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>

        <!-- 右下角提示 -->
        <Border x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,26,54" CornerRadius="12" Background="#F2141A24"
                BorderBrush="#3A5B8CFF" BorderThickness="1" Padding="14,11"
                MaxWidth="380" Visibility="Collapsed" Opacity="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="⇩" FontSize="16" Foreground="#FF8AB4FF"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" Text="" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ToastDetail" Text="" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource InkFaint}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 启动动画 -->
        <Grid x:Name="SplashOverlay" Background="#FF070A12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="92" Height="92" CornerRadius="26" Background="{StaticResource AccentGrad}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#5B8CFF" BlurRadius="48" ShadowDepth="0" Opacity="0.75"/>
                    </Border.Effect>
                    <TextBlock Text="M" FontSize="48" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="MEME LAUNCHER" FontFamily="{StaticResource FontHead}" FontSize="19"
                           Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                <TextBlock x:Name="SplashStatus" Text="正在准备…" FontSize="11.5"
                           Foreground="{StaticResource InkFaint}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
