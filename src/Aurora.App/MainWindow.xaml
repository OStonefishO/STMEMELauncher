<Window x:Class="Aurora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MEME Launcher" Height="800" Width="1280"
        MinHeight="620" MinWidth="1040"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource FontBody}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="AppBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF05070D" Offset="0"/>
            <GradientStop Color="#FF0A1020" Offset="0.55"/>
            <GradientStop Color="#FF070A12" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF5B8CFF" Offset="0"/>
            <GradientStop Color="#FF7C5CFF" Offset="0.6"/>
            <GradientStop Color="#FF22D3EE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFB9C8FF" Offset="0.6"/>
            <GradientStop Color="#FF7C5CFF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="DockBg" Color="#F0120A20"/>
        <SolidColorBrush x:Key="ComboPopupBg" Color="#FF141A26"/>
        <SolidColorBrush x:Key="ComboPopupLine" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboItemHover" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="ComboItemActive" Color="#335B8CFF"/>
        <SolidColorBrush x:Key="FieldBg" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="FieldLine" Color="#26FFFFFF"/>

        <SolidColorBrush x:Key="WarnBg" Color="#1AFFB44A"/>
        <SolidColorBrush x:Key="WarnInk" Color="#FFC87A"/>
        <SolidColorBrush x:Key="DangerBg" Color="#2EFF5B5B"/>
        <SolidColorBrush x:Key="DangerBgHover" Color="#48FF5B5B"/>
        <SolidColorBrush x:Key="DangerLine" Color="#7AFF6B5B"/>
        <SolidColorBrush x:Key="DangerInk" Color="#FFFFB4A8"/>

        <!-- 版本选择弹层（各主题在 ApplyUiLayout 里覆盖） -->
        <SolidColorBrush x:Key="PopBg" Color="#FF141A26"/>
        <SolidColorBrush x:Key="PopField" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="PopLine" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="PopHover" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="PopActive" Color="#335B8CFF"/>
        <SolidColorBrush x:Key="PopInk" Color="#FFE6EAF2"/>
        <SolidColorBrush x:Key="PopSub" Color="#FF99A2B5"/>
        <SolidColorBrush x:Key="PopFaint" Color="#FF6D7588"/>
        <SolidColorBrush x:Key="PopAccent" Color="#FF5B8CFF"/>
        <SolidColorBrush x:Key="Glass" Color="#B3121620"/>
        <SolidColorBrush x:Key="GlassLine" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#FFE6EAF2"/>
        <SolidColorBrush x:Key="InkDim" Color="#FF99A2B5"/>
        <SolidColorBrush x:Key="InkFaint" Color="#FF6D7588"/>
        <FontFamily x:Key="FontHead">Microsoft YaHei UI Light</FontFamily>
        <FontFamily x:Key="FontBody">Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="FontNum">Segoe UI Variable Display</FontFamily>

        <!-- 窗口按钮 -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航 -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow" CornerRadius="30" Background="{DynamicResource AccentGrad}"
                                    Opacity="0.38" Margin="-5">
                                <Border.Effect>
                                    <BlurEffect Radius="18"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="b" CornerRadius="30" Background="{DynamicResource AccentGrad}" TextElement.Foreground="{TemplateBinding Foreground}">
                                <Border Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="glow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮 -->

        <!-- 强制关闭：比普通按钮明显大一号，红橙强调 -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DangerInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="#2EFF5B5B"
                                BorderBrush="#7AFF6B5B" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#48FF5B5B"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3FF8B7B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerBgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource GlassLine}" BorderThickness="1"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5B8CFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#40FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑条（进度 / 音量） -->
        <Style x:Key="TrackSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource FieldLine}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentGrad}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="18" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#FFFFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌单条目 -->
        <Style x:Key="TrackItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="10" Background="Transparent" Padding="8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2A44"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5B8CFF"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 版本卡片 -->
        <Style x:Key="VersionTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Width="224" CornerRadius="14" Background="{DynamicResource FieldBg}"
                                BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" Padding="14,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentGrad}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1.6"/>
                                <Setter TargetName="b" Property="Background" Value="#1E2A44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 滚动条：深色细条 -->
        <Style x:Key="MemeScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#66FFFFFF" CornerRadius="5" Margin="3,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MemeScrollBar}"/>

        <!-- 下拉框：深色 -->
        <Style x:Key="MemeComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ComboItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ComboItemActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MemeComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource FieldLine}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="12,0,6,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                <Path Grid.Column="1" Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource InkDim}"
                                                      StrokeThickness="1.4" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ComboItemHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource ComboPopupBg}" BorderBrush="{DynamicResource ComboPopupLine}" BorderThickness="1"
                                        CornerRadius="10" Margin="0,6,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid ClipToBounds="True">
        <!-- 背景 -->
        <Border Background="{DynamicResource AppBg}"/>
        <!-- 极光版：整屏 3D 方块岛背景 -->
        <Viewport3D x:Name="AuroraBackdrop" IsHitTestVisible="False" Opacity="0.42" Visibility="Collapsed">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="17,13,21" LookDirection="-17,-7.5,-21" UpDirection="0,1,0" FieldOfView="42"/>
            </Viewport3D.Camera>
        </Viewport3D>

        <!-- 扫描线（像素 / 终端） -->
        <Rectangle x:Name="ScanlineOverlay" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.16">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#22000000">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,4,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>


        <!-- 极光色块 -->
        <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-380,-260,0" Opacity="0.55" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#665B8CFF" Offset="0"/>
                    <GradientStop Color="#005B8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-300,0,0,-320" Opacity="0.45" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#557C5CFF" Offset="0"/>
                    <GradientStop Color="#007C5CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 粒子 -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentGrad}">
                        <TextBlock Text="M" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MEME" FontWeight="Bold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="LAUNCHER" FontSize="10" Margin="7,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkFaint}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border CornerRadius="10" Background="{DynamicResource FieldBg}" Padding="10,5" Margin="0,0,10,0"
                            BorderBrush="{DynamicResource GlassLine}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF4ADE80" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="AccountChip" Text="离线：Steve" FontSize="11.5"
                                       Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ChromeButton}" Click="OnToggleLayout" Content="◐" FontSize="13"
                            ToolTip="切换新版 / 经典界面"/>
                    <Button Style="{StaticResource ChromeButton}" Click="OnToggleFullscreen" Content="&#x26F6;" FontSize="12"
                            ToolTip="全屏 / 退出全屏（F11）"/>
                    <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" Content="—" FontSize="12"/>
                    <Button Style="{StaticResource ChromeButton}" Click="OnCloseWindow" Content="✕" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- ===== 主体 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="74"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 底部浮动 dock（新版布局：侧栏换成底部胶囊条） -->
                <Border x:Name="BottomDock" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,10,0,0" CornerRadius="22" Background="{DynamicResource DockBg}"
                        BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="10,6"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel x:Name="DockPanel" Orientation="Horizontal"/>
                </Border>

                <!-- 导航栏 -->
                <StackPanel x:Name="RailPanel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,40"
                            MouseEnter="OnRailEnter" MouseLeave="OnRailLeave">
                    <Button x:Name="NavLaunch" Style="{StaticResource RailButton}" Tag="0" Click="OnNavClick">
                        <StackPanel>
                            <TextBlock Text="◈" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="启动" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavContent" Style="{StaticResource RailButton}" Tag="2" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="▦" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="内容" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavVersions" Style="{StaticResource RailButton}" Tag="7" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="❖" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="版本" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavOnline" Style="{StaticResource RailButton}" Tag="6" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="⇄" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="联机" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavFun" Style="{StaticResource RailButton}" Tag="8" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="♫" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="娱乐" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAccount" Style="{StaticResource RailButton}" Tag="3" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="账号" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource RailButton}" Tag="4" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="⚙" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="设置" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavOther" Style="{StaticResource RailButton}" Tag="10" Click="OnNavClick" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="⋯" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="其他" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 页面 -->
                <Grid Grid.Column="1" Margin="10,0,22,0">

                    <!-- ========== 主页 ========== -->
                    <Grid x:Name="LaunchPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        
                            <RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <!-- 极光背景（仅新版布局显示） -->
                        <Canvas x:Name="AuroraLayer" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                            <Ellipse x:Name="AuroraA" Width="620" Height="620" Canvas.Left="-120" Canvas.Top="-160">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#66FF3D8B" Offset="0"/>
                                        <GradientStop Color="#00FF3D8B" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="AuroraB" Width="720" Height="720" Canvas.Left="360" Canvas.Top="-120">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#557A3CFF" Offset="0"/>
                                        <GradientStop Color="#007A3CFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="AuroraC" Width="560" Height="560" Canvas.Left="140" Canvas.Top="180">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#4400E5FF" Offset="0"/>
                                        <GradientStop Color="#0000E5FF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
                            </Ellipse>
                        </Canvas>

                        <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" CornerRadius="12"
                                Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource PopAccent}" BorderThickness="1"
                                Padding="14,10" Margin="26,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⇪" FontSize="15" Foreground="{DynamicResource PopAccent}" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="UpdateBannerText" Text="发现新版本" FontSize="12.5"
                                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="UpdateBannerButton" Content="立即更新" HorizontalAlignment="Right"
                                        Style="{StaticResource GlassButton}" Click="OnApplyUpdateNow"
                                        ToolTip="直接下载并替换成新版本"
                                        Padding="12,5" FontSize="11.5"/>
                            </Grid>
                        </Border>

                        <!-- 仪表盘首页（新版布局） -->
                        <!-- 纸质便签首页：单列活页清单 -->
                        <Grid x:Name="PaperHome" Grid.Row="1" Margin="26,0,26,60" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border CornerRadius="6" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="26,20" Margin="0,4,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CURRENT VERSION" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkFaint}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock FontSize="54" FontFamily="{DynamicResource FontNum}"
                                                       Foreground="{DynamicResource TitleGrad}"
                                                       Text="{Binding Text, ElementName=BigVersion}"/>
                                        </StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                                   Text="{Binding Text, ElementName=DetName}" Margin="0,2,0,0"/>
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource InkDim}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Text="{Binding Text, ElementName=DetMeta}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="▶  开始游戏" Style="{StaticResource HeroButton}" Width="210" Height="46"
                                                FontSize="15" Click="OnLaunch" Tag="noBounce"/>
                                        <Button x:Name="PaperKillButton" Content="强制关闭游戏" Style="{StaticResource DangerButton}"
                                                Margin="0,8,0,0" Click="OnForceKillGame" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1">
                                <Grid>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,4,0"
                                            Background="#FFF4D27A" CornerRadius="3" Padding="14,8"
                                            RenderTransformOrigin="0.5,0.5" Panel.ZIndex="2">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="3.2"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#552B2622" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="记得先备份存档 ✍" FontFamily="Segoe Script" FontSize="13"
                                                       Foreground="#FF6B4A2E"/>
                                            <TextBlock Text="装模组前把 saves 复制一份" FontFamily="Segoe Script" FontSize="10.5"
                                                       Foreground="#FF8A6A4A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border CornerRadius="6" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                                        BorderThickness="1" Padding="20,14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="01" FontFamily="Georgia" FontSize="13" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Width="34"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="内容库" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="模组 / 材质包 / 光影 / 整合包，四个来源" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="进入 →" Style="{StaticResource GlassButton}" Tag="2" Click="OnNavClick"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="6" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                                        BorderThickness="1" Padding="20,14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="02" FontFamily="Georgia" FontSize="13" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Width="34"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="版本" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="安装、隔离、导入存档" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="进入 →" Style="{StaticResource GlassButton}" Tag="7" Click="OnNavClick"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="6" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                                        BorderThickness="1" Padding="20,14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="03" FontFamily="Georgia" FontSize="13" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Width="34"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="联机" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="一键开服 + 樱花穿透" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="进入 →" Style="{StaticResource GlassButton}" Tag="6" Click="OnNavClick"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="6" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                                        BorderThickness="1" Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="04" FontFamily="Georgia" FontSize="13" Foreground="{DynamicResource InkFaint}"
                                                   VerticalAlignment="Center" Width="34"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="账号 / 设置" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Text="微软登录、内存、镜像、界面" FontSize="11" Foreground="{DynamicResource InkDim}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="账号" Style="{StaticResource GlassButton}" Tag="3" Click="OnNavClick"/>
                                            <Button Content="设置" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="4" Click="OnNavClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>


                        <!-- 像素 8bit 首页：方块网格 -->
                        <!-- 新版（动感）首页：左侧信息 + 右侧整屏 3D 岛 -->
                        <Grid x:Name="VividHome" Grid.Row="1" Margin="26,0,26,60" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.02*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="6,0,10,0">
                                <TextBlock Text="CURRENT VERSION" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkFaint}"/>
                                <TextBlock FontSize="96" FontWeight="Black" Margin="0,4,0,0"
                                           FontFamily="{DynamicResource FontNum}"
                                           Foreground="{DynamicResource TitleGrad}"
                                           Text="{Binding Text, ElementName=BigVersion}"/>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                           Margin="0,2,0,0" Text="{Binding Text, ElementName=DetName}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource InkDim}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Text="{Binding Text, ElementName=DetMeta}"/>
                                <Button Content="▶  开始游戏" Style="{StaticResource HeroButton}" Height="62"
                                        FontSize="18" Margin="0,24,0,0" Click="OnLaunch" Tag="noBounce"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="打开目录" Style="{StaticResource GlassButton}" Click="OnOpenFolder"/>
                                    <Button Content="内容库" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="2" Click="OnNavClick"/>
                                    <Button Content="版本管理" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Tag="7" Click="OnNavClick"/>
                                    <Button x:Name="VividKillButton" Content="强制关闭" Style="{StaticResource DangerButton}"
                                            Margin="8,0,0,0" Click="OnForceKillGame" Visibility="Collapsed"/>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" ClipToBounds="True">
                                <Viewport3D x:Name="VividViewport" IsHitTestVisible="True" Cursor="Hand"
                                            MouseLeftButtonDown="OnDashboardBiomeClick"/>
                                <TextBlock x:Name="VividBiomeText" Text="主世界 · 点一下换群系" FontSize="10.5"
                                           Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Margin="0,0,10,6" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>


                        <!-- 终端首页：命令行 + 信息表 -->
                        <Grid x:Name="TerminalHome" Grid.Row="1" Margin="26,0,26,60" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="8" Background="#FF070C09" BorderBrush="{DynamicResource GlassLine}"
                                    BorderThickness="1" Margin="0,4,8,0" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="7,7,0,0" Background="#FF0E1712" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#FF35F07A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="meme@launcher: ~" FontFamily="Consolas" FontSize="11.5"
                                                       Foreground="{DynamicResource InkDim}"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="16,14,16,16">
                                        <TextBlock Text="meme-launcher --status" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource InkFaint}"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Ink}"
                                                   Margin="0,10,0,0" TextWrapping="Wrap">
                                            <Run Text="version  : "/><Run Text="{Binding Text, ElementName=BigVersion}" Foreground="#FF35F07A"/>
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource InkDim}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="{Binding Text, ElementName=DetName}"/>
                                        <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource InkFaint}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="{Binding Text, ElementName=DetMeta}"/>
                                        <TextBlock Text="> 选择操作：" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#FF35F07A" Margin="0,16,0,0"/>
                                        <Button Content="&gt; start game" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Style="{StaticResource HeroButton}" Height="46" Padding="26,0"
                                                FontFamily="Consolas" Click="OnLaunch" Tag="noBounce"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="&gt; contents" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                    FontFamily="Consolas" Tag="2" Click="OnNavClick"/>
                                            <Button Content="&gt; versions" Style="{StaticResource GlassButton}" Margin="0,0,8,8"
                                                    FontFamily="Consolas" Tag="7" Click="OnNavClick"/>
                                            <Button x:Name="TermKillButton" Content="&gt; kill" Style="{StaticResource DangerButton}"
                                                    Margin="0,0,8,8" FontFamily="Consolas" Click="OnForceKillGame" Visibility="Collapsed"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource Glass}"
                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Margin="8,4,0,0" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM" FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{DynamicResource InkFaint}"/>
                                    <TextBlock Text="-------------------" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource InkFaint}" Margin="0,6,0,0"/>
                                    <TextBlock Text="user   : 1134 (offline)" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource InkDim}" Margin="0,6,0,0"/>
                                    <TextBlock Text="dir    : 见设置" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource InkDim}" Margin="0,4,0,0"/>
                                    <TextBlock Text="ui     : terminal" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource InkDim}" Margin="0,4,0,0"/>
                                    <TextBlock Text="-------------------" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource InkFaint}" Margin="0,10,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="账户" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="3" Click="OnNavClick"/>
                                        <Button Content="联机" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="6" Click="OnNavClick"/>
                                        <Button Content="设置" Style="{StaticResource GlassButton}" Margin="0,0,8,8" Tag="4" Click="OnNavClick"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>


                        <!-- 极光首页：全屏 3D 背景 + 居中玻璃卡 -->
