                                        <StackPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="添加音乐" Style="{StaticResource HeroButton}"
                                                        Height="30" Padding="14,0" FontSize="11.5" Click="OnMusicAdd"/>
                                                <Button Content="添加文件夹" Style="{StaticResource GlassButton}"
                                                        Height="30" Padding="12,0" FontSize="11.5" Margin="8,0,0,0"
                                                        Click="OnMusicAddFolder"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PlaylistHint" Text="也可以把音乐文件直接拖进列表"
                                                       FontSize="10.5" Foreground="{DynamicResource InkFaint}"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <ListBox x:Name="SongList" Grid.Row="1" Margin="0,10,0,0"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource Ink}"
                                                 ItemContainerStyle="{StaticResource TrackItem}"
                                                 SelectionChanged="OnSongSelected"
                                                 AllowDrop="True" Drop="OnSongDrop" DragOver="OnSongDragOver"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,6">
                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Sub}" FontSize="10"
                                                                   Foreground="{DynamicResource InkFaint}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="清空列表" Style="{StaticResource GlassButton}"
                                                    Padding="10,4" FontSize="10.5" Click="OnMusicClear"/>
                                            <TextBlock x:Name="SongCountText" Text="0 首" FontSize="10.5"
                                                       Foreground="{DynamicResource InkFaint}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="16"
                                        Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                                        BorderThickness="1" Padding="20,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock x:Name="NowTitle" Text="还没有选歌" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock x:Name="NowArtist" Text="左边挑一首，或者把音乐拖进来"
                                                           FontSize="11" Foreground="{DynamicResource InkFaint}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                <TextBlock x:Name="LyricSource" Text="" FontSize="10"
                                                           Foreground="{DynamicResource InkFaint}" Margin="10,1,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ScrollViewer x:Name="LyricScroll" Grid.Row="1" Margin="0,10,0,0"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PanningMode="VerticalOnly">
                                            <StackPanel x:Name="LyricPanel" Margin="2,40,2,60"/>
                                        </ScrollViewer>

                                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                            <Slider x:Name="SeekBar" Style="{StaticResource TrackSlider}"
                                                    Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True"
                                                    ValueChanged="OnSeekChanged"
                                                    Thumb.DragStarted="OnSeekDragStart"
                                                    Thumb.DragCompleted="OnSeekDragEnd"/>
                                            <Grid Margin="2,2,2,0">
                                                <TextBlock x:Name="TimeNow" Text="0:00" FontSize="10.5"
                                                           Foreground="{DynamicResource InkFaint}"/>
                                                <TextBlock x:Name="TimeTotal" Text="0:00" FontSize="10.5"
                                                           Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="◀◀" Style="{StaticResource GlassButton}" Width="54"
                                                            Height="34" Padding="0" FontSize="10" ToolTip="上一首"
                                                            Click="OnMusicPrev"/>
                                                    <Button x:Name="PlayButton" Content="▶" Style="{StaticResource HeroButton}"
                                                            Width="78" Height="34" Margin="8,0,0,0" Padding="0" FontSize="13"
                                                            ToolTip="播放 / 暂停" Click="OnMusicPlayPause"/>
                                                    <Button Content="▶▶" Style="{StaticResource GlassButton}" Width="54"
                                                            Height="34" Padding="0" FontSize="10" Margin="8,0,0,0"
                                                            ToolTip="下一首" Click="OnMusicNext"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="音量" FontSize="10.5"
                                                               Foreground="{DynamicResource InkFaint}"
                                                               VerticalAlignment="Center"/>
                                                    <Slider x:Name="VolumeBar" Style="{StaticResource TrackSlider}"
                                                            Width="86" Margin="8,0,0,0" Minimum="0" Maximum="100"
                                                            Value="70" IsMoveToPointEnabled="True"
                                                            ValueChanged="OnVolumeChanged"/>
                                                    <TextBlock x:Name="VolText" Text="70%" FontSize="10.5" Width="34"
                                                               Margin="8,0,0,0" TextAlignment="Right"
                                                               Foreground="{DynamicResource InkFaint}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="88,6,26,12">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5"
                           Foreground="{DynamicResource InkFaint}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>

        <!-- 右下角提示 -->
        <Border x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,26,54" CornerRadius="12" Background="{DynamicResource PopBg}"
                BorderBrush="{DynamicResource PopLine}" BorderThickness="1" Padding="14,11"
                MaxWidth="380" Visibility="Collapsed" Opacity="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="⇩" FontSize="16" Foreground="{DynamicResource PopAccent}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" Text="" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ToastDetail" Text="" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource InkFaint}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 启动动画 -->
        <Grid x:Name="SplashOverlay" Background="#FF070A12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="92" Height="92" CornerRadius="26" Background="{DynamicResource AccentGrad}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#5B8CFF" BlurRadius="48" ShadowDepth="0" Opacity="0.75"/>
                    </Border.Effect>
                    <TextBlock Text="M" FontSize="48" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="MEME LAUNCHER" FontFamily="{DynamicResource FontHead}" FontSize="19"
                           Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                <TextBlock x:Name="SplashStatus" Text="正在准备…" FontSize="11.5"
                           Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
